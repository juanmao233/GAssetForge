<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GAssetForge.McpServer</RootNamespace>
    <AssemblyName>GAssetForge.McpServer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GAssetForge.Core/GAssetForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <Target Name="RemoveSymbolsFromSingleFilePublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(PublishSingleFile)' == 'true' and '$(DebugSymbols)' == 'false'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
