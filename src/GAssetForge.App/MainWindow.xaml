<Window x:Class="GAssetForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:adc="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:core="clr-namespace:GAssetForge.Core.Workflows;assembly=GAssetForge.Core"
        Title="GAssetForge · 原生美术工作台"
        Width="1500"
        Height="920"
        MinWidth="1120"
        MinHeight="700"
        Icon="/GAssetForge;component/Assets/Branding/GAssetForge.ico"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource App.WindowStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PfButton}" />
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource App.TextBoxStyle}" />
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource App.CheckBoxStyle}" />
        <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource App.SliderStyle}" />
        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource App.MenuItemStyle}" />
        <Style x:Key="NewProjectWorkflowItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="MinHeight" Value="142" />
            <Setter Property="Margin" Value="7" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="App.DockTabCloseButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource App.IconButtonStyle}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="2,0,4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="ToolTip" Value="关闭标签" />
        </Style>

        <DataTemplate x:Key="App.DockAnchorableTabHeaderTemplate">
            <Grid MinHeight="31" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="10,0,3,0"
                           VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        automation:AutomationProperties.Name="{Binding Title, StringFormat='关闭 {0}'}"
                        Command="{Binding LayoutItem.HideCommand, RelativeSource={RelativeSource AncestorType={x:Type adc:LayoutAnchorableTabItem}}}"
                        Content="×"
                        Style="{StaticResource App.DockTabCloseButtonStyle}"
                        Tag="{Binding}" />
            </Grid>
        </DataTemplate>

        <!-- Document tabs already own their height, padding and close button in AvalonDock. -->
        <DataTemplate x:Key="App.DockDocumentTabHeaderTemplate">
            <TextBlock Margin="8,0,4,0"
                       VerticalAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <!--
            VS2013 的默认 Anchorable 模板将页签固定在内容下方，并在只有一个
            页面时隐藏页签。这里保留 AvalonDock 的完整页签/内容宿主语义，只把
            页签行移到顶部，并让单页工具窗口也始终显示可拖拽的页签。
        -->
        <Style x:Key="App.DockAnchorableContentStyle"
               TargetType="{x:Type adc:LayoutAnchorableControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type adc:LayoutAnchorableControl}">
                        <Border Background="{DynamicResource App.BackgroundBrush}">
                            <ContentPresenter Content="{Binding LayoutItem.View, RelativeSource={RelativeSource TemplatedParent}}"
                                              ContentTemplate="{Binding LayoutItem.View.ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                              ContentTemplateSelector="{Binding LayoutItem.View.ContentTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                              FlowDirection="{TemplateBinding FlowDirection}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="App.DockAnchorablePaneControlStyle"
               TargetType="{x:Type adc:LayoutAnchorablePaneControl}">
            <Setter Property="TabStripPlacement" Value="Top" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type adc:LayoutAnchorablePaneControl}">
                        <Grid ClipToBounds="True"
                              KeyboardNavigation.TabNavigation="Local"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.RowSpan="2" Background="Transparent" />
                            <Border Grid.Row="0"
                                    Background="{DynamicResource App.SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1,1,1,0">
                                <adc:AnchorablePaneTabPanel x:Name="HeaderPanel"
                                                            MinHeight="32"
                                                            Margin="0"
                                                            Panel.ZIndex="1"
                                                            IsItemsHost="True"
                                                            KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Margin="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2"
                                    KeyboardNavigation.TabNavigation="Cycle">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type TabItem}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TabItem}">
                                    <Grid MinHeight="32" SnapsToDevicePixels="True">
                                        <Border x:Name="TabBackground"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource App.BorderBrush}"
                                                BorderThickness="0,0,1,1" />
                                        <Border x:Name="SelectionLine"
                                                Height="2"
                                                VerticalAlignment="Bottom"
                                                Background="{DynamicResource App.AccentBrush}"
                                                Visibility="Collapsed" />
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          ContentSource="Header"
                                                          RecognizesAccessKey="True"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Selector.IsSelected" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="1" />
                                            <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
                                            <Setter TargetName="SelectionLine" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True" />
                                                <Condition Property="Selector.IsSelected" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource App.SurfaceHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <adc:LayoutAnchorableTabItem Model="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <adc:LayoutAnchorableControl Model="{Binding}"
                                                     Style="{StaticResource App.DockAnchorableContentStyle}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenNewProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding UiSaveCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UiUndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding UiRedoCommand}" />
        <KeyBinding Key="F12"
                    Command="{Binding ShowPanelCommand}"
                    CommandParameter="command-console" />
        <KeyBinding Key="Delete" Command="{Binding UiDeleteCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Style="{StaticResource App.MenuStyle}"
              IsEnabled="{Binding IsWorkspaceInteractionEnabled}"
              Background="{DynamicResource SurfaceBrush}">
            <MenuItem x:Name="FileMenu" Header="文件(_F)">
                <MenuItem x:Name="NewProjectMenuItem"
                          Header="新建项目…"
                          InputGestureText="Ctrl+N"
                          Command="{Binding OpenNewProjectCommand}" />
                <Separator />
                <MenuItem Header="保存" InputGestureText="Ctrl+S" Command="{Binding UiSaveCommand}" />
                <Separator />
                <MenuItem Header="导入项目…" Command="{Binding UiImportCommand}" />
                <MenuItem Header="导出项目…" Command="{Binding UiExportCommand}" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤销" InputGestureText="Ctrl+Z" Command="{Binding UiUndoCommand}" />
                <MenuItem Header="重做" InputGestureText="Ctrl+Y" Command="{Binding UiRedoCommand}" />
                <Separator />
                <MenuItem Header="删除所选图层" InputGestureText="Delete" Command="{Binding UiDeleteCommand}" />
            </MenuItem>
            <MenuItem x:Name="McpAccessMenu" Header="MCP 接入(_M)">
                <MenuItem x:Name="AddAgentConnectionMenuItem"
                          Header="打开 Agent 连接面板"
                          Command="{Binding OpenAgentConnectionCommand}" />
            </MenuItem>
            <MenuItem x:Name="ViewMenu" Header="视图(_V)" SubmenuOpened="ViewMenu_OnSubmenuOpened">
                <MenuItem x:Name="ShowToolsMenuItem" Header="工具面板" Command="{Binding ShowPanelCommand}" CommandParameter="ui-tools" />
                <MenuItem x:Name="ShowCanvasMenuItem" Header="主界面" Command="{Binding ShowPanelCommand}" CommandParameter="ui-canvas" />
                <MenuItem x:Name="ShowPropertiesMenuItem" Header="属性面板" Command="{Binding ShowPanelCommand}" CommandParameter="ui-properties" />
                <MenuItem x:Name="ShowLayersMenuItem" Header="图层面板" Command="{Binding ShowPanelCommand}" CommandParameter="ui-layers" />
                <MenuItem x:Name="ShowProjectMenuItem" Header="项目面板" Command="{Binding ShowPanelCommand}" CommandParameter="ui-project" />
                <MenuItem x:Name="ShowStyleLibraryMenuItem"
                          Header="美术风格素材库"
                          IsCheckable="True"
                          Command="{Binding TogglePanelCommand}"
                          CommandParameter="art-style-library" />
                <MenuItem x:Name="ShowAssetGenerationMenuItem"
                          Header="素材生成"
                          IsCheckable="True"
                          Command="{Binding TogglePanelCommand}"
                          CommandParameter="asset-generation" />
                <MenuItem x:Name="ShowBackgroundRemovalMenuItem"
                          Header="背景剔除工具"
                          IsCheckable="True"
                          Command="{Binding TogglePanelCommand}"
                          CommandParameter="background-removal" />
                <MenuItem x:Name="ShowPixelAlignmentMenuItem"
                          Header="像素点对齐工具"
                          IsCheckable="True"
                          Command="{Binding TogglePanelCommand}"
                          CommandParameter="pixel-grid-alignment" />
                <MenuItem x:Name="ShowBlueprintMenuItem"
                          Header="蓝图窗口"
                          IsCheckable="True"
                          Command="{Binding TogglePanelCommand}"
                          CommandParameter="workflow-blueprint" />
                <MenuItem x:Name="ShowCommandConsoleMenuItem"
                          Header="指令日志"
                          InputGestureText="F12"
                          IsCheckable="True"
                          Command="{Binding TogglePanelCommand}"
                          CommandParameter="command-console" />
                <Separator />
                <MenuItem Header="恢复默认停靠布局" Command="{Binding ResetLayoutCommand}" />
                <MenuItem Header="切换暗色 / 亮色" Command="{Binding ToggleThemeCommand}" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                IsEnabled="{Binding IsWorkspaceInteractionEnabled}"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <StackPanel x:Name="CurrentProjectIndicator"
                                MinWidth="190"
                                Margin="4,0,8,0"
                                VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding CurrentProjectDisplayName}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{Binding CurrentWorkflow.Accent}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding CurrentWorkflow.Label}" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="OpenAssetGenerationButton"
                            Height="34"
                            MinWidth="112"
                            Margin="8,0,0,0"
                            Padding="12,0"
                            Command="{Binding ShowPanelCommand}"
                            CommandParameter="asset-generation"
                            Content="✦  素材生成" />
                    <Separator Margin="10,1" />
                    <Button Width="34" Height="34" ToolTip="保存" Command="{Binding UiSaveCommand}" Content="💾" />
                    <Button Width="34" Height="34" Margin="6,0,0,0" ToolTip="撤销" Command="{Binding UiUndoCommand}" Content="↶" />
                    <Button Width="34" Height="34" Margin="6,0,0,0" ToolTip="重做" Command="{Binding UiRedoCommand}" Content="↷" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Height="34" MinWidth="92" Padding="10,0" Command="{Binding ToggleThemeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0" Text="◐" />
                            <TextBlock Text="{Binding CurrentThemeLabel}" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="UiZoomToolbar" Margin="8,0,0,0" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUiWorkspace}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Width="34" Height="34" ToolTip="缩小" Command="{Binding UiZoomOutCommand}" Content="−" />
                        <Button Height="34" MinWidth="64" Margin="4,0" Command="{Binding UiResetZoomCommand}" Content="{Binding EditorWorkspace.ZoomText}" />
                        <Button Width="34" Height="34" ToolTip="放大" Command="{Binding UiZoomInCommand}" Content="+" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Margin="18,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding CurrentWorkflow.Description}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <ad:DockingManager x:Name="DockManager"
                           Grid.Row="2"
                           IsEnabled="{Binding IsWorkspaceInteractionEnabled}"
                           AllowMixedOrientation="True"
                           AllowAnchorDoubleClickDock="True"
                           AllowMovingFloatingWindowWithKeyboard="True"
                           AnchorableHeaderTemplate="{StaticResource App.DockAnchorableTabHeaderTemplate}"
                           DocumentHeaderTemplate="{StaticResource App.DockDocumentTabHeaderTemplate}"
                           AnchorablePaneControlStyle="{StaticResource App.DockAnchorablePaneControlStyle}"
                           Background="{DynamicResource WindowBackgroundBrush}"
                           Theme="{Binding DockTheme}" />

        <Border Grid.Row="3"
                IsEnabled="{Binding IsWorkspaceInteractionEnabled}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUiWorkspace}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding EditorWorkspace.ActiveToolLabel}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding EditorWorkspace.DocumentMeta}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding EditorWorkspace.SaveStateText}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Text="{Binding WorkspaceStatusText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid x:Name="NewProjectOverlay"
              Grid.RowSpan="4"
              Panel.ZIndex="100"
              Focusable="True"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNewProjectDialogOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="#B9000000" />
            <Border Width="1040"
                    MaxHeight="820"
                    Margin="32"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Width="34"
                                Height="34"
                                Command="{Binding CloseNewProjectCommand}"
                                Content="×" />
                        <StackPanel>
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="新建项目" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="选择业务模板与保存位置，创建独立的 Assets、Packages 和 ProjectSettings 项目目录。" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Height="1" Margin="0,22" Background="{DynamicResource BorderBrush}" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="项目名称" />
                            <TextBox x:Name="NewProjectNameTextBox"
                                     MinHeight="36"
                                     Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="项目保存位置" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox MinHeight="36"
                                         IsReadOnly="True"
                                         Text="{Binding NewProjectParentPath, Mode=OneWay}" />
                                <Button Grid.Column="1"
                                        MinWidth="96"
                                        Margin="8,0,0,0"
                                        Command="{Binding ChooseNewProjectLocationCommand}"
                                        Content="选择位置…" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="3"
                            Margin="0,18,0,10"
                            Padding="12,10"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="最终项目位置" />
                            <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding NewProjectTargetPath}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding NewProjectValidationMessage}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="NewProjectWorkflowList"
                                 ItemsSource="{Binding Workflows}"
                                 SelectedItem="{Binding SelectedNewProjectWorkflow, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource NewProjectWorkflowItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:WorkflowDefinition}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,3,9,0" Fill="{Binding Accent}" />
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Category}" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Margin="0,9,0,12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="3" Foreground="{Binding Accent}" Text="选择此模板" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    <DockPanel Grid.Row="5" Margin="0,20,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Right"
                                MinWidth="138"
                                Height="38"
                                Command="{Binding CreateNewProjectCommand}"
                                Content="创建并进入项目" />
                        <Button DockPanel.Dock="Right"
                                MinWidth="86"
                                Height="38"
                                Margin="0,0,10,0"
                                Command="{Binding CloseNewProjectCommand}"
                                Content="取消" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
