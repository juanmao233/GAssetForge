<Window x:Class="GAssetForge.App.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GAssetForge.App.Controls"
        Title="选择颜色"
        Width="720"
        Height="520"
        MinWidth="680"
        MinHeight="500"
        MaxWidth="920"
        MaxHeight="720"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource App.WindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DrawingBrush x:Key="ColorPickerCheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,12,12"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFB9BDC4">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,12,12" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFE1E3E7">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,6,6" />
                                <RectangleGeometry Rect="6,6,6,6" />
                            </GeometryGroup>
                            </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="ColorPickerLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
        </Style>
        <Style x:Key="ColorPickerNumberStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource App.TextBoxStyle}">
            <Setter Property="Width" Value="76" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Padding" Value="7,4" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="拾色器" />
            <TextBlock Margin="0,3,0,0"
                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                       Text="在色域中取色，或直接编辑 HSV、RGB 与十六进制数值。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="258" />
            </Grid.ColumnDefinitions>

            <Border Padding="13"
                    Background="{DynamicResource App.SurfaceBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#FF000000"
                                BorderBrush="{DynamicResource App.BorderStrongBrush}"
                                BorderThickness="1">
                            <controls:HsvSaturationValueSurface x:Name="SaturationValueSurface"
                                                                MinWidth="260"
                                                                MinHeight="260"
                                                                Hue="{Binding Hue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Saturation="{Binding Saturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                ToolTip="拖动选择饱和度和明度；方向键可微调" />
                        </Border>
                        <controls:HueSpectrumSlider Grid.Column="2"
                                                    Hue="{Binding Hue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ToolTip="拖动选择色相；方向键微调，Shift 加速" />
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource App.TextMutedBrush}"
                               FontSize="11"
                               Text="横向：饱和度    纵向：明度    右侧：色相"
                               TextAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="10"
                            Background="{DynamicResource App.SurfaceBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid Height="76">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Margin="0,20,7,0"
                                    Background="{StaticResource ColorPickerCheckerBrush}"
                                    BorderBrush="{DynamicResource App.BorderStrongBrush}"
                                    BorderThickness="1">
                                <Border Background="{Binding OriginalColorBrush}" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                                       Text="原色" />
                            <Border Grid.Column="1" Background="{DynamicResource App.BorderBrush}" />
                            <Border Grid.Column="2"
                                    Margin="7,20,0,0"
                                    Background="{StaticResource ColorPickerCheckerBrush}"
                                    BorderBrush="{DynamicResource App.BorderStrongBrush}"
                                    BorderThickness="1">
                                <Border Background="{Binding SelectedColorBrush}" />
                            </Border>
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                                       Text="新色" />
                        </Grid>
                    </Border>

                    <GroupBox Margin="0,10,0,0"
                              Header="HSV"
                              Style="{StaticResource App.GroupBoxStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource ColorPickerLabelStyle}" Text="H" />
                            <TextBox x:Name="HueTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource ColorPickerNumberStyle}"
                                     Text="{Binding Hue, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.##, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            <TextBlock Grid.Column="2" Margin="5,0,0,0" Style="{StaticResource ColorPickerLabelStyle}" Text="°" />
                            <TextBlock Grid.Row="2" Style="{StaticResource ColorPickerLabelStyle}" Text="S" />
                            <TextBox x:Name="SaturationTextBox"
                                     Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource ColorPickerNumberStyle}"
                                     Text="{Binding SaturationPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.##, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="5,0,0,0" Style="{StaticResource ColorPickerLabelStyle}" Text="%" />
                            <TextBlock Grid.Row="4" Style="{StaticResource ColorPickerLabelStyle}" Text="V" />
                            <TextBox x:Name="ValueTextBox"
                                     Grid.Row="4" Grid.Column="1"
                                     Style="{StaticResource ColorPickerNumberStyle}"
                                     Text="{Binding ValuePercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.##, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Margin="5,0,0,0" Style="{StaticResource ColorPickerLabelStyle}" Text="%" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="RGB" Style="{StaticResource App.GroupBoxStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource ColorPickerLabelStyle}" Text="R" />
                            <TextBox x:Name="RedTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource ColorPickerNumberStyle}"
                                     Text="{Binding Red, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource ColorPickerLabelStyle}" Text="G" />
                            <TextBox x:Name="GreenTextBox"
                                     Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource ColorPickerNumberStyle}"
                                     Text="{Binding Green, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            <TextBlock Grid.Row="4" Style="{StaticResource ColorPickerLabelStyle}" Text="B" />
                            <TextBox x:Name="BlueTextBox"
                                     Grid.Row="4" Grid.Column="1"
                                     Style="{StaticResource ColorPickerNumberStyle}"
                                     Text="{Binding Blue, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                        </Grid>
                    </GroupBox>

                    <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Text="十六进制（#RRGGBB）" />
                    <TextBox x:Name="HexTextBox"
                             Margin="0,5,0,0"
                             Style="{StaticResource App.TextBoxStyle}"
                             FontFamily="Consolas"
                             MaxLength="7"
                             Text="{Binding HexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource App.DangerBrush}"
                               FontSize="10"
                               Text="{Binding HexValidationMessage}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasHexError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4">
            <Button HorizontalAlignment="Left"
                    Command="{Binding ResetToOriginalCommand}"
                    Content="恢复原色"
                    Style="{StaticResource App.ButtonStyle}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="88"
                        Margin="0,0,8,0"
                        Click="OnAcceptClick"
                        Content="确定"
                        IsDefault="True"
                        Style="{StaticResource App.ButtonStyle}" />
                <Button MinWidth="88"
                        Click="OnCancelClick"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource App.ButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
