<UserControl x:Class="GAssetForge.App.Views.BlueprintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             MinWidth="620"
             MinHeight="360">
    <UserControl.Resources>
        <DrawingBrush x:Key="BlueprintGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,24,24"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,24,24"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource App.BorderBrush}" Thickness="0.5" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,24,24" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="BlueprintScopeChipStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource App.InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,0"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right"
                        Padding="9,4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource App.InputBackgroundBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                               FontSize="11"
                               Text="等待节点规则" />
                </Border>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="25"
                            Height="25"
                            Margin="0,0,9,0"
                            Background="{DynamicResource App.AccentBrush}"
                            CornerRadius="4">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="15"
                                   Text="◇" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding Header}" />
                        <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="10"
                                   Text="Agent 驱动轨迹与工具工作流" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="BlueprintCanvas"
              Grid.Row="1"
              automation:AutomationProperties.Name="蓝图工作流画布"
              Background="{DynamicResource App.CanvasBackgroundBrush}"
              ClipToBounds="True">
            <Rectangle Fill="{StaticResource BlueprintGridBrush}"
                       IsHitTestVisible="False"
                       Opacity="0.55" />

            <Border x:Name="BlueprintEmptyState"
                    Width="560"
                    MaxWidth="560"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource App.SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <Border Width="52"
                            Height="52"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource App.InputBackgroundBrush}"
                            BorderBrush="{DynamicResource App.AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.AccentBrush}"
                                   FontSize="27"
                                   Text="◇" />
                    </Border>

                    <TextBlock x:Name="BlueprintEmptyStateTitle"
                               Margin="0,18,0,0"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="{Binding EmptyStateTitle}" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource App.TextSecondaryBrush}"
                               FontSize="13"
                               LineHeight="21"
                               Text="{Binding EmptyStateDescription}"
                               TextWrapping="Wrap" />

                    <ItemsControl Margin="0,20,0,0" ItemsSource="{Binding PlannedNodeKinds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BlueprintScopeChipStyle}">
                                    <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}"
                                               FontSize="11"
                                               Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource App.TextMutedBrush}"
                               FontSize="11"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="10,0"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="10"
                           Text="{Binding PersistenceText}" />
                <TextBlock x:Name="BlueprintStatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="10"
                           Text="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
