<UserControl x:Class="GAssetForge.App.Views.TilemapPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TilemapPropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="TilemapMetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="12,0"
                Background="{DynamicResource App.SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <TextBlock VerticalAlignment="Center"
                           Style="{DynamicResource App.PanelHeaderStyle}"
                           Text="Tilemap 属性" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="11"
                           Text="透视与像素约束" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">
                <Border Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="网格单位"
                                   Style="{DynamicResource App.SectionTitleStyle}" />
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="单格边长"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                            <TextBox x:Name="GridUnitSizeTextBox"
                                     Grid.Column="1"
                                     Text="{Binding GridUnitSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                     Style="{DynamicResource App.TextBoxStyle}" />
                            <TextBlock Grid.Column="2"
                                       Margin="6,0,0,0"
                                       Text="单位"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                        </Grid>
                        <Slider x:Name="GridUnitSizeSlider"
                                Margin="96,7,0,0"
                                Minimum="8"
                                Maximum="512"
                                SmallChange="1"
                                LargeChange="16"
                                Value="{Binding GridUnitSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource App.SliderStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主网格间隔"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MajorLineInterval, StringFormat={}{0} 格}"
                                       Style="{StaticResource TilemapMetricValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="美术图尺寸"
                                   Style="{DynamicResource App.SectionTitleStyle}" />
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="W" Style="{StaticResource TilemapPropertyLabelStyle}" />
                            <TextBox x:Name="ArtImageWidthTextBox"
                                     Grid.Column="1"
                                     Text="{Binding ArtImageWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{DynamicResource App.TextBoxStyle}" />
                            <TextBlock Grid.Column="3"
                                       Text="H"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                            <TextBox x:Name="ArtImageHeightTextBox"
                                     Grid.Column="4"
                                     Text="{Binding ArtImageHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{DynamicResource App.TextBoxStyle}" />
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="当前尺寸"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ArtSizeText}"
                                       Style="{StaticResource TilemapMetricValueStyle}" />
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="宽高比"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ImageAspectRatioText}"
                                       Style="{StaticResource TilemapMetricValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="透视投影"
                                   Style="{DynamicResource App.SectionTitleStyle}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="A/B 边夹角"
                                       ToolTip="只控制瓦片两条相邻边的夹角，不代表整体旋转方向。"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                            <TextBox x:Name="DiamondAngleTextBox"
                                     Grid.Column="1"
                                     Text="{Binding DiamondAngle, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                     Style="{DynamicResource App.TextBoxStyle}" />
                            <TextBlock Grid.Column="2"
                                       Margin="6,0,0,0"
                                       Text="°"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                        </Grid>
                        <Slider x:Name="DiamondAngleSlider"
                                Margin="96,7,0,0"
                                Minimum="15"
                                Maximum="165"
                                SmallChange="0.5"
                                LargeChange="5"
                                Value="{Binding DiamondAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource App.SliderStyle}" />

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="A 边方向"
                                       ToolTip="A 边相对屏幕 X 轴的方向；0° 为水平向右，正值顺时针。"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                             <TextBox x:Name="RotationAngleTextBox"
                                      Grid.Column="1"
                                      ToolTip="0° 时 A/X 轴水平；正值按屏幕坐标顺时针旋转。"
                                      Text="{Binding RotationAngle, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                      Style="{DynamicResource App.TextBoxStyle}" />
                            <TextBlock Grid.Column="2"
                                       Margin="6,0,0,0"
                                       Text="°"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                        </Grid>
                        <Slider x:Name="RotationAngleSlider"
                                Margin="96,7,0,0"
                                Minimum="-180"
                                Maximum="180"
                                 SmallChange="1"
                                 LargeChange="15"
                                 ToolTip="0° 时 A/X 轴水平；正值按屏幕坐标顺时针旋转。"
                                 Value="{Binding RotationAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource App.SliderStyle}" />

                        <UniformGrid Margin="0,13,0,0" Columns="2">
                            <Button Margin="0,0,4,0"
                                    Content="等距预设"
                                    Command="{Binding ApplyIsometricPresetCommand}"
                                    Style="{DynamicResource App.ButtonStyle}" />
                            <Button Margin="4,0,0,0"
                                    Content="方形预设"
                                    Command="{Binding ApplySquarePresetCommand}"
                                    Style="{DynamicResource App.ButtonStyle}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="换算结果"
                                   Style="{DynamicResource App.SectionTitleStyle}" />
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="投影瓦片"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProjectedTileSizeText}"
                                       Style="{StaticResource TilemapMetricValueStyle}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="旋转包围盒"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RotatedFootprintText}"
                                       Style="{StaticResource TilemapMetricValueStyle}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="像素密度"
                                       Style="{StaticResource TilemapPropertyLabelStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PixelDensityText}"
                                       Style="{StaticResource TilemapMetricValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Padding="12"
                        Background="{DynamicResource App.InputBackgroundBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="AI 生成约束"
                                   Foreground="{DynamicResource App.TilemapGuideBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,0"
                                   Text="{Binding AiGenerationConstraint}"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontSize="11"
                                   LineHeight="18"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Button x:Name="ResetTilemapParametersButton"
                        Margin="0,10,0,4"
                        Content="恢复默认参数"
                        Command="{Binding ResetParametersCommand}"
                        Style="{DynamicResource App.ButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
