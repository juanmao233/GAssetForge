<UserControl x:Class="GAssetForge.App.Views.ArtWorkspaceToolPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="78">
    <Grid Background="{DynamicResource App.SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="8,10"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                           FontWeight="SemiBold"
                           Text="美术画布" />
                <TextBlock Margin="0,3,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="9"
                           Text="随活动主视图切换" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="7,10">
                <ToggleButton x:Name="ArtWorkspaceToolSelectButton"
                              Height="60"
                              Padding="4"
                              HorizontalContentAlignment="Center"
                              Command="{Binding SelectMoveToolCommand}"
                              IsChecked="{Binding IsSelectMoveToolActive, Mode=OneWay}"
                              Style="{DynamicResource App.ToggleButtonStyle}"
                              ToolTip="选择移动：单击选择图片，按住左键移动对象">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="18"
                                   Text="↖" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="9"
                                   Text="选择移动" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="ArtWorkspaceToolRegionSelectButton"
                              Height="60"
                              Margin="0,6,0,0"
                              Padding="4"
                              HorizontalContentAlignment="Center"
                              Command="{Binding ImageRegionSelectToolCommand}"
                              IsChecked="{Binding IsImageRegionSelectToolActive, Mode=OneWay}"
                              IsEnabled="{Binding HasSelectedImage}"
                              Style="{DynamicResource App.ToggleButtonStyle}"
                              ToolTip="图像框选：先选择图片，再在图片上按住左键拖出需要交给 Agent 关注的区域">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="20"
                                   Text="⌗" />
                        <TextBlock Margin="0,3,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="9"
                                   Text="图像框选" />
                    </StackPanel>
                </ToggleButton>

                <Button x:Name="ArtWorkspaceClearRegionButton"
                        MinHeight="34"
                        Margin="0,6,0,0"
                        Padding="4"
                        Click="ArtWorkspaceClearRegionButton_OnClick"
                        Content="取消框选"
                        IsEnabled="{Binding HasSelectedImageRegion}"
                        Style="{DynamicResource App.ButtonStyle}"
                        ToolTip="清除当前图片上已经框选的区域" />

                <Button x:Name="ArtWorkspaceToolImportButton"
                        MinHeight="54"
                        Margin="0,12,0,0"
                        Padding="4"
                        Command="{Binding ImportImagesCommand}"
                        Style="{DynamicResource App.ButtonStyle}"
                        ToolTip="导入一张或多张参考图片">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontSize="18" Text="＋" />
                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9" Text="导入图片" />
                    </StackPanel>
                </Button>

                <Button x:Name="ArtWorkspaceToolOutputButton"
                        MinHeight="54"
                        Margin="0,6,0,0"
                        Padding="4"
                        Command="{Binding FocusOutputFrameCommand}"
                        Style="{DynamicResource App.ButtonStyle}"
                        ToolTip="聚焦新美术资源输出框">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontSize="17" Text="▣" />
                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9" Text="输出框" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="8,0,8,10"
                Padding="7"
                Background="{DynamicResource App.SurfaceRaisedBrush}"
                CornerRadius="5">
            <TextBlock HorizontalAlignment="Center"
                       Foreground="{DynamicResource App.TextMutedBrush}"
                       FontSize="9"
                       Text="框选仅作用于当前图片"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
