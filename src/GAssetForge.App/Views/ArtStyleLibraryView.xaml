<UserControl x:Class="GAssetForge.App.Views.ArtStyleLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GAssetForge.App.Converters"
             MinWidth="560"
             MinHeight="390">
    <UserControl.Resources>
        <conv:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />

        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource App.ButtonStyle}" />
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource App.TextBoxStyle}" />

        <Style x:Key="StyleLibraryToolbarButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource App.ButtonStyle}">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style x:Key="StyleLibraryIconButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource App.ButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="StyleLibraryFieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="StyleLibraryMutedTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StyleGroupListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Chrome"
                                Padding="10,9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource App.SurfaceHoverBrush}" />
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource App.BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource App.SelectionBrush}" />
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource App.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleAssetListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Width" Value="156" />
            <Setter Property="Height" Value="154" />
            <Setter Property="Margin" Value="0,0,9,9" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource App.SurfaceHoverBrush}" />
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource App.BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource App.SelectionBrush}" />
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource App.AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Padding="16,11"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AnalyzeUnifiedStylePromptButton"
                            Command="{Binding AnalyzeUnifiedPromptCommand}"
                            Style="{StaticResource StyleLibraryToolbarButtonStyle}"
                            ToolTip="让已连接的 Agent 检查当前组全部参考图并保存可复用的统一提示词样本">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE945;" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding AnalyzeUnifiedPromptButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportStyleAssetsButton"
                            Command="{Binding ImportAssetsCommand}"
                            Style="{StaticResource StyleLibraryToolbarButtonStyle}"
                            ToolTip="从本地导入图像到当前风格组">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8B5;" />
                            <TextBlock VerticalAlignment="Center" Text="导入素材" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RemoveStyleAssetButton"
                            Command="{Binding RemoveAssetCommand}"
                            Style="{StaticResource StyleLibraryToolbarButtonStyle}"
                            ToolTip="从当前风格组移除所选素材">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE74D;" />
                            <TextBlock VerticalAlignment="Center" Text="移除所选" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="36"
                            Height="36"
                            Margin="0,0,11,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource App.SelectionBrush}"
                            BorderBrush="{DynamicResource App.AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.AccentBrush}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Text="&#xEB9F;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="美术风格素材库" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontSize="10"
                                   Text="用参考资产定义稳定的画面语言与 AI 风格提示词" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="175" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="325" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource App.SurfaceBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="12,9"
                            Background="{DynamicResource App.SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="{Binding Groups.Count, StringFormat={}{0} 组}" />
                            <TextBlock Style="{StaticResource App.PanelHeaderStyle}"
                                       Text="风格组" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="StyleGroupList"
                                 Margin="7"
                                 Padding="0"
                                 ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource App.TextPrimaryBrush}"
                                 ItemContainerStyle="{StaticResource StyleGroupListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22"
                                                Height="22"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource App.InputBackgroundBrush}"
                                                CornerRadius="4">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource App.AccentBrush}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Text="&#xE8B7;" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                                       FontSize="9"
                                                       Text="{Binding AssetCountText}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       MaxHeight="28"
                                                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                       FontSize="9"
                                                       LineHeight="13"
                                                       Text="{Binding Description}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Margin="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="30"
                                       Text="&#xE8B7;" />
                            <TextBlock Margin="0,9,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="尚未创建风格组" />
                            <TextBlock Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Style="{StaticResource StyleLibraryMutedTextStyle}"
                                       Text="新建一组风格，再导入若干参考资产。" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="7"
                            Background="{DynamicResource App.SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="False">
                            <Button x:Name="DeleteStyleGroupButton"
                                    DockPanel.Dock="Right"
                                    Command="{Binding DeleteGroupCommand}"
                                    Content="&#xE74D;"
                                    Style="{StaticResource StyleLibraryIconButtonStyle}"
                                    ToolTip="删除当前风格组" />
                            <Button x:Name="NewStyleGroupButton"
                                    MinWidth="112"
                                    Height="28"
                                    Padding="10,3"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CreateGroupCommand}"
                                    Style="{StaticResource App.ButtonStyle}"
                                    ToolTip="创建新的美术风格组">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE710;" />
                                    <TextBlock VerticalAlignment="Center" Text="新建风格组" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource App.BorderBrush}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Grid Grid.Column="2">
                <Grid x:Name="SelectedGroupWorkspace">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGroup}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*" MinHeight="230" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="6*" MinHeight="135" />
                    </Grid.RowDefinitions>

                    <Border Padding="14,11"
                            Background="{DynamicResource App.SurfaceBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid DataContext="{Binding SelectedGroup}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,9" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                           FontSize="10"
                                           Text="修改后自动保存" />
                                <TextBlock Style="{StaticResource App.PanelHeaderStyle}"
                                           Text="风格定义" />
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="130" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="3*" MinWidth="170" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="92" />
                                    <RowDefinition Height="*" MinHeight="92" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Style="{StaticResource StyleLibraryFieldLabelStyle}"
                                               Text="风格组名称" />
                                    <TextBox x:Name="StyleNameTextBox"
                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,9,0,0">
                                    <TextBlock Style="{StaticResource StyleLibraryFieldLabelStyle}"
                                               Text="风格描述" />
                                    <TextBox x:Name="StyleDescriptionTextBox"
                                             MinHeight="64"
                                             AcceptsReturn="True"
                                             Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,9,0,0">
                                    <TextBlock Style="{StaticResource StyleLibraryFieldLabelStyle}"
                                               Text="AI 风格提示词" />
                                    <TextBox x:Name="StylePromptTextBox"
                                             MinHeight="64"
                                             AcceptsReturn="True"
                                             FontFamily="Consolas, Microsoft YaHei UI"
                                             FontSize="11"
                                             Text="{Binding StylePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>

                                <Border Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource App.SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource App.BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                                       FontSize="9"
                                                       Text="{Binding UnifiedPromptGeneratedAtText, StringFormat=生成时间：{0}}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource StyleLibraryFieldLabelStyle}"
                                                           Text="统一提示词样本" />
                                                <Border Margin="8,-1,0,0"
                                                        Padding="6,2"
                                                        Background="{DynamicResource App.SelectionBrush}"
                                                        CornerRadius="3">
                                                    <TextBlock Foreground="{DynamicResource App.AccentBrush}"
                                                               FontSize="9"
                                                               Text="{Binding UnifiedPromptStateText}" />
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBox x:Name="UnifiedStylePromptTextBox"
                                                 Grid.Row="1"
                                                 MinHeight="62"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 FontFamily="Consolas, Microsoft YaHei UI"
                                                 FontSize="10.5"
                                                 Text="{Binding UnifiedPromptText, Mode=OneWay}"
                                                 TextWrapping="Wrap"
                                                 ToolTip="{Binding UnifiedPromptSummary}"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{DynamicResource App.BorderBrush}"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows"
                                  ShowsPreview="True" />

                    <Border x:Name="AssetGalleryBorder"
                            Grid.Row="2"
                            AllowDrop="True"
                            Background="{DynamicResource App.SurfaceBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0"
                            PreviewDragEnter="AssetDropZone_OnPreviewDragEnter"
                            PreviewDragOver="AssetDropZone_OnPreviewDragOver"
                            PreviewDragLeave="AssetDropZone_OnPreviewDragLeave"
                            PreviewDrop="AssetDropZone_OnPreviewDrop">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="12,8"
                                    Background="{DynamicResource App.SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                               FontSize="10"
                                               Text="{Binding SelectedGroup.AssetCountText}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource App.PanelHeaderStyle}"
                                                   Text="参考素材" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                                   FontSize="10"
                                                   Text="可拖入 PNG、JPG、WEBP、BMP、GIF 或 TIFF" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Row="1">
                                <ListBox x:Name="StyleAssetList"
                                         Margin="11"
                                         Padding="0"
                                         ItemsSource="{Binding SelectedGroup.Assets}"
                                         SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource StyleAssetListItemStyle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Margin="5,5,5,0"
                                                        Background="{DynamicResource App.InputBackgroundBrush}"
                                                        CornerRadius="4"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="24"
                                                                   Text="&#xEB9F;" />
                                                        <Image Source="{Binding FullPath, Converter={StaticResource FilePathToImageSourceConverter}, ConverterParameter=320}"
                                                               Stretch="Uniform"
                                                               SnapsToDevicePixels="True"
                                                               ToolTip="{Binding FullPath}" />
                                                        <Border HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="4"
                                                                Padding="4,2"
                                                                Background="{DynamicResource App.OverlayBrush}"
                                                                CornerRadius="3">
                                                            <TextBlock Foreground="White"
                                                                       FontSize="8"
                                                                       Text="{Binding Extension}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="8,6,8,5">
                                                    <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FullPath}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                                               FontSize="8"
                                                               Text="{Binding AvailabilityText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding RelativePath}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Margin="24"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedGroup.Assets.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="32"
                                               Text="&#xE898;" />
                                    <TextBlock Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="把参考图像放入这个风格组" />
                                    <TextBlock Margin="0,5,0,10"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                               FontSize="10"
                                               Text="将图片拖放到此处，或从本地文件中导入" />
                                    <Button MinWidth="108"
                                            HorizontalAlignment="Center"
                                            Command="{Binding ImportAssetsCommand}"
                                            Content="选择图像…" />
                                </StackPanel>

                                <Border x:Name="DropOverlay"
                                        Margin="9"
                                        Padding="20"
                                        Background="{DynamicResource App.OverlayBrush}"
                                        BorderBrush="{DynamicResource App.AccentBrush}"
                                        BorderThickness="2"
                                        CornerRadius="7"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource App.AccentBrush}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="34"
                                                   Text="&#xE74A;" />
                                        <TextBlock Margin="0,9,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="释放以加入当前风格组" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Margin="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGroup}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource App.SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="26"
                                   Text="&#xE8B7;" />
                    </Border>
                    <TextBlock Margin="0,13,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="选择一个风格组开始定义" />
                    <TextBlock Margin="0,6,0,12"
                               MaxWidth="330"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource StyleLibraryMutedTextStyle}"
                               Text="风格组会把参考资产、描述和 AI 提示词组织在一起，作为后续美术生成的风格前提。" />
                    <Button MinWidth="118"
                            HorizontalAlignment="Center"
                            Command="{Binding CreateGroupCommand}"
                            Content="新建风格组" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="9,0"
                Background="{DynamicResource App.SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,7,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.AccentBrush}"
                           FontSize="8"
                           Text="●" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="9"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
