<UserControl x:Class="GAssetForge.App.Views.IconDesignPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             MinWidth="260">
    <UserControl.Resources>
        <Style x:Key="IconPropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="IconMetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="12,0"
                Background="{DynamicResource App.SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <TextBlock VerticalAlignment="Center"
                           Style="{DynamicResource App.PanelHeaderStyle}"
                           Text="Icon 图标属性" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="11"
                           Text="相机与画幅约束" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">
                <Border Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="制作模式"
                                   Style="{DynamicResource App.SectionTitleStyle}" />
                        <ComboBox x:Name="IconDesignModeComboBox"
                                  Margin="0,11,0,0"
                                  ItemsSource="{Binding ModeOptions}"
                                  SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{DynamicResource App.ComboBoxStyle}"
                                  automation:AutomationProperties.Name="Icon 制作模式" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="11"
                                   LineHeight="17"
                                   Text="{Binding ModeDescription}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="美术图画幅"
                                   Style="{DynamicResource App.SectionTitleStyle}" />
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="W" Style="{StaticResource IconPropertyLabelStyle}" />
                            <TextBox x:Name="IconImageWidthTextBox"
                                     Grid.Column="1"
                                     Text="{Binding ImageWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{DynamicResource App.TextBoxStyle}"
                                     automation:AutomationProperties.Name="Icon 图片宽度" />
                            <TextBlock Grid.Column="3"
                                       Text="H"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                            <TextBox x:Name="IconImageHeightTextBox"
                                     Grid.Column="4"
                                     Text="{Binding ImageHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{DynamicResource App.TextBoxStyle}"
                                     automation:AutomationProperties.Name="Icon 图片高度" />
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="当前画幅"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ImageSizeText}"
                                       Style="{StaticResource IconMetricValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="相机角度"
                                   Style="{DynamicResource App.SectionTitleStyle}" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="10"
                                   LineHeight="16"
                                   Text="正值方位角向 +X 环绕；正值仰角从上方俯视；正值滚转使最终画面顺时针旋转。"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="相机方位角"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding CameraAzimuthDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                     Style="{DynamicResource App.TextBoxStyle}" />
                            <TextBlock Grid.Column="2" Margin="6,0,0,0" Text="°"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                        </Grid>
                        <Slider x:Name="IconCameraAzimuthSlider"
                                Margin="96,7,0,0"
                                Minimum="-180"
                                Maximum="180"
                                TickFrequency="1"
                                Value="{Binding CameraAzimuthDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource App.SliderStyle}"
                                automation:AutomationProperties.Name="相机方位角" />

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="相机仰角"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding CameraElevationDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                     Style="{DynamicResource App.TextBoxStyle}" />
                            <TextBlock Grid.Column="2" Margin="6,0,0,0" Text="°"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                        </Grid>
                        <Slider x:Name="IconCameraElevationSlider"
                                Margin="96,7,0,0"
                                Minimum="-85"
                                Maximum="85"
                                TickFrequency="1"
                                Value="{Binding CameraElevationDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource App.SliderStyle}"
                                automation:AutomationProperties.Name="相机仰角" />

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="镜头滚转"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding CameraRollDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                     Style="{DynamicResource App.TextBoxStyle}" />
                            <TextBlock Grid.Column="2" Margin="6,0,0,0" Text="°"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                        </Grid>
                        <Slider x:Name="IconCameraRollSlider"
                                Margin="96,7,0,0"
                                Minimum="-180"
                                Maximum="180"
                                TickFrequency="1"
                                Value="{Binding CameraRollDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource App.SliderStyle}"
                                automation:AutomationProperties.Name="镜头滚转角" />
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="镜头参数"
                                   Style="{DynamicResource App.SectionTitleStyle}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="镜头焦距"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding FocalLengthMillimeters, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                     Style="{DynamicResource App.TextBoxStyle}" />
                            <TextBlock Grid.Column="2" Margin="6,0,0,0" Text="mm"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                        </Grid>
                        <Slider x:Name="IconFocalLengthSlider"
                                Margin="96,7,0,0"
                                Minimum="12"
                                Maximum="200"
                                TickFrequency="1"
                                Value="{Binding FocalLengthMillimeters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource App.SliderStyle}"
                                automation:AutomationProperties.Name="镜头焦距" />

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="相机物距"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding CameraDistance, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                     Style="{DynamicResource App.TextBoxStyle}" />
                        </Grid>
                        <Slider x:Name="IconCameraDistanceSlider"
                                Margin="96,7,0,0"
                                Minimum="1.5"
                                Maximum="20"
                                TickFrequency="0.1"
                                Value="{Binding CameraDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource App.SliderStyle}"
                                automation:AutomationProperties.Name="相机物距" />
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Text="镜头检查"
                                   Style="{DynamicResource App.SectionTitleStyle}" />
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="视场角"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FieldOfViewText}"
                                       Style="{StaticResource IconMetricValueStyle}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="相机坐标"
                                       Style="{StaticResource IconPropertyLabelStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CameraPositionText}"
                                       Style="{StaticResource IconMetricValueStyle}" />
                        </Grid>
                        <TextBlock Margin="0,9,0,0"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   Text="{Binding FramingText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="11"
                                   Text="{Binding FramingStateText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Padding="12"
                        Background="{DynamicResource App.InputBackgroundBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="生成角度描述"
                                   Foreground="{DynamicResource App.TilemapGuideBrush}"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="IconGenerationDescriptionTextBox"
                                 Margin="0,8,0,0"
                                 MinHeight="130"
                                 Style="{DynamicResource App.TextBoxStyle}"
                                 IsReadOnly="True"
                                 Text="{Binding GenerationDescription, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 automation:AutomationProperties.Name="Icon 生成角度描述" />
                    </StackPanel>
                </Border>

                <UniformGrid Margin="0,10,0,0" Columns="2">
                    <Button Margin="0,0,4,4"
                            Content="正面"
                            Command="{Binding ApplyFrontPresetCommand}"
                            Style="{DynamicResource App.ButtonStyle}" />
                    <Button Margin="4,0,0,4"
                            Content="3/4 视角"
                            Command="{Binding ApplyThreeQuarterPresetCommand}"
                            Style="{DynamicResource App.ButtonStyle}" />
                    <Button Margin="0,4,4,0"
                            Content="高位 3/4"
                            Command="{Binding ApplyTopThreeQuarterPresetCommand}"
                            Style="{DynamicResource App.ButtonStyle}" />
                    <Button Margin="4,4,0,0"
                            Content="恢复默认"
                            Command="{Binding ResetCommand}"
                            Style="{DynamicResource App.ButtonStyle}" />
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
