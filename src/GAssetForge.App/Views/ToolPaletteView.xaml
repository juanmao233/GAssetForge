<UserControl x:Class="GAssetForge.App.Views.ToolPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GAssetForge.App.Converters"
             MinWidth="72">
    <UserControl.Resources>
        <conv:EditorToolToBooleanConverter x:Key="EditorToolToBooleanConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12,10"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="工具"
                       Foreground="{DynamicResource App.TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       TextAlignment="Center" />
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="7,10">
            <ToggleButton Height="64"
                          Padding="4"
                          HorizontalContentAlignment="Center"
                          Command="{Binding SelectToolCommand}"
                          CommandParameter="move"
                          IsChecked="{Binding ActiveTool, Mode=OneWay, Converter={StaticResource EditorToolToBooleanConverter}, ConverterParameter=Move}"
                          Style="{DynamicResource App.ToggleButtonStyle}"
                          ToolTip="选择 / 移动 (V)">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7C9;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="19"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="0,5,0,0"
                               Text="移动"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontSize="10"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton Height="64"
                          Margin="0,6,0,0"
                          Padding="4"
                          HorizontalContentAlignment="Center"
                          Command="{Binding SelectToolCommand}"
                          CommandParameter="text"
                          IsChecked="{Binding ActiveTool, Mode=OneWay, Converter={StaticResource EditorToolToBooleanConverter}, ConverterParameter=Text}"
                          Style="{DynamicResource App.ToggleButtonStyle}"
                          ToolTip="文字工具 (T)">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="T"
                               FontFamily="Segoe UI"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="0,4,0,0"
                               Text="文字"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontSize="10"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="RectangleToolButton"
                          Height="58"
                          Margin="0,10,0,0"
                          Padding="4"
                          HorizontalContentAlignment="Center"
                          Command="{Binding SelectToolCommand}"
                          CommandParameter="rectangle"
                          IsChecked="{Binding ActiveTool, Mode=OneWay, Converter={StaticResource EditorToolToBooleanConverter}, ConverterParameter=Rectangle}"
                          Style="{DynamicResource App.ToggleButtonStyle}"
                          ToolTip="拖拽创建矩形">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="▭"
                               FontFamily="Segoe UI Symbol"
                               FontSize="21"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,2,0,0"
                               Text="矩形"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontSize="10"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="CircleToolButton"
                          Height="58"
                          Margin="0,6,0,0"
                          Padding="4"
                          HorizontalContentAlignment="Center"
                          Command="{Binding SelectToolCommand}"
                          CommandParameter="circle"
                          IsChecked="{Binding ActiveTool, Mode=OneWay, Converter={StaticResource EditorToolToBooleanConverter}, ConverterParameter=Circle}"
                          Style="{DynamicResource App.ToggleButtonStyle}"
                          ToolTip="拖拽创建圆形">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="○"
                               FontFamily="Segoe UI Symbol"
                               FontSize="22"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,2,0,0"
                               Text="圆形"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontSize="10"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="PolygonToolButton"
                          Height="58"
                          Margin="0,6,0,0"
                          Padding="4"
                          HorizontalContentAlignment="Center"
                          Command="{Binding SelectToolCommand}"
                          CommandParameter="polygon"
                          IsChecked="{Binding ActiveTool, Mode=OneWay, Converter={StaticResource EditorToolToBooleanConverter}, ConverterParameter=Polygon}"
                          Style="{DynamicResource App.ToggleButtonStyle}"
                          ToolTip="拖拽创建规则多边形">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⬡"
                               FontFamily="Segoe UI Symbol"
                               FontSize="20"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,2,0,0"
                               Text="多边形"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontSize="9"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="8,0,8,10" Padding="8"
                Background="{DynamicResource App.SurfaceRaisedBrush}"
                CornerRadius="5">
            <StackPanel>
                <TextBlock Text="当前"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="10" />
                <TextBlock Margin="0,3,0,0"
                           Text="{Binding ActiveToolLabel}"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="9"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
