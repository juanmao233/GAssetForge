<UserControl x:Class="GAssetForge.App.Views.AssetGenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GAssetForge.App.Converters"
             MinWidth="700"
             MinHeight="420">
    <UserControl.Resources>
        <conv:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />
        <conv:StringToBrushConverter x:Key="StringToBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource App.ButtonStyle}" />
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource App.TextBoxStyle}" />
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource App.ComboBoxStyle}" />

        <Style x:Key="GenerationCardStyle"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource App.CardStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="15" />
        </Style>

        <Style x:Key="GenerationFieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GenerationMutedTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="GenerationToolbarButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource App.ButtonStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style x:Key="GenerationSmallButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource App.ButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style x:Key="GenerationStepBadgeStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="GenerationMetricCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <Style x:Key="GenerationAssetListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Width" Value="146" />
            <Setter Property="Height" Value="142" />
            <Setter Property="Margin" Value="0,0,9,9" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource App.SurfaceHoverBrush}" />
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource App.BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource App.SelectionBrush}" />
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource App.AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GenerationDataGridStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{DynamicResource App.InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="All" />
            <Setter Property="RowBackground" Value="{DynamicResource App.InputBackgroundBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="CellOrRowHeader" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="True" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserResizeRows" Value="True" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeaderWidth" Value="38" />
            <Setter Property="ColumnHeaderHeight" Value="32" />
            <Setter Property="RowHeight" Value="50" />
            <Setter Property="MinRowHeight" Value="34" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridRowHeader}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <Border Padding="16,11"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding ShowBackgroundRemovalCommand}"
                            Style="{StaticResource GenerationToolbarButtonStyle}"
                            ToolTip="打开可独立停靠的背景剔除工具">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12"
                                    Height="12"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding BackgroundRemoval.EffectiveColorHex, Converter={StaticResource StringToBrushConverter}}"
                                    BorderBrush="{DynamicResource App.BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                            <TextBlock VerticalAlignment="Center" Text="背景剔除" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowStyleLibraryCommand}"
                            Style="{StaticResource GenerationToolbarButtonStyle}"
                            ToolTip="打开美术风格素材库">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xEB9F;" />
                            <TextBlock VerticalAlignment="Center" Text="风格素材库" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowAgentConnectionCommand}"
                            Style="{StaticResource GenerationToolbarButtonStyle}"
                            ToolTip="打开 MCP Agent 接入面板">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource App.WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAgentConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource App.SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center" Text="{Binding ConnectionStatusText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="38"
                            Height="38"
                            Margin="0,0,11,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource App.SelectionBrush}"
                            BorderBrush="{DynamicResource App.AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.AccentBrush}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Text="&#xE768;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="素材生成" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontSize="10"
                                   Text="组合风格参考、Tilemap 约束与内容描述，在应用内直接调度 Agent 生成素材" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="790" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" MinWidth="420" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="4*" MinWidth="330" />
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              Margin="3,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource App.BorderBrush}"
                              Cursor="SizeWE"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"
                              ShowsPreview="True"
                              ToolTip="拖动调整表格区与任务预览区的宽度" />

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource GenerationCardStyle}">
                        <Grid>
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                         </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,13">
                                <Border Style="{StaticResource GenerationStepBadgeStyle}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.AccentBrush}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Text="1" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource App.PanelHeaderStyle}"
                                               Text="选择风格与生成步骤" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource GenerationMutedTextStyle}"
                                               Text="当前风格组的提示词和参考图片会作为本次生成的视觉前提。" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource GenerationFieldLabelStyle}"
                                               Text="美术风格组" />
                                    <ComboBox x:Name="AssetGenerationStyleComboBox"
                                              ItemsSource="{Binding StyleGroups}"
                                              SelectedItem="{Binding SelectedStyleGroup, Mode=TwoWay}"
                                              DisplayMemberPath="Name" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource GenerationFieldLabelStyle}"
                                               Text="生成步骤" />
                                    <ComboBox x:Name="AssetGenerationStepComboBox"
                                              ItemsSource="{Binding GenerationSteps}"
                                              SelectedItem="{Binding SelectedGenerationStep, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    Margin="0,10,0,0"
                                    Padding="9,7"
                                    Background="{DynamicResource App.SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}"
                                           FontSize="10"
                                           Text="{Binding SelectedGenerationStep.Description}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Border Grid.Row="3"
                                    Margin="0,12,0,0"
                                    Padding="10"
                                    Background="{DynamicResource App.SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource GenerationFieldLabelStyle}"
                                                   Text="第一道工序 · 生成底色" />
                                        <ComboBox x:Name="AssetGenerationBackgroundPresetComboBox"
                                                  ItemsSource="{Binding BackgroundRemoval.PresetOptions}"
                                                  SelectedItem="{Binding BackgroundRemoval.SelectedPreset, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource GenerationFieldLabelStyle}"
                                                   Text="精确颜色" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30"
                                                    Height="28"
                                                    Background="{Binding BackgroundRemoval.EffectiveColorHex, Converter={StaticResource StringToBrushConverter}}"
                                                    BorderBrush="{DynamicResource App.BorderStrongBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4" />
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding BackgroundRemoval.EffectiveColorHex}">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BackgroundRemoval.IsCustomPreset}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Grid.Column="2"
                                                     FontFamily="Consolas"
                                                     Text="{Binding BackgroundRemoval.CustomColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding BackgroundRemoval.IsCustomPreset, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </StackPanel>
                                    <Button Grid.Column="4"
                                            MinWidth="92"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding ShowBackgroundRemovalCommand}"
                                            Content="高级参数…"
                                            Style="{StaticResource GenerationSmallButtonStyle}" />
                                    <TextBlock Grid.Column="0"
                                               Grid.Row="1"
                                               Grid.ColumnSpan="5"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                               FontSize="9"
                                               Text="Agent 生成均匀纯色底原图；本地工具逐张剔色并验证后，最终透明 PNG 才计入生成进度。"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="112" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                               FontSize="9"
                                               Text="{Binding SelectedStyleGroup.AssetCountText}" />
                                    <TextBlock Style="{StaticResource GenerationFieldLabelStyle}"
                                               Margin="0"
                                               Text="风格参考图片" />
                                </DockPanel>
                                <Border Grid.Row="1"
                                        Background="{DynamicResource App.InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource App.BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Grid>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl Margin="7"
                                                          ItemsSource="{Binding SelectedStyleGroup.Assets}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="102"
                                                                Height="88"
                                                                Margin="0,0,7,0"
                                                                Background="{DynamicResource App.SurfaceRaisedBrush}"
                                                                BorderBrush="{DynamicResource App.BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                ClipToBounds="True"
                                                                ToolTip="{Binding FullPath}">
                                                            <Grid>
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="22"
                                                                           Text="&#xEB9F;" />
                                                                <Image Margin="3,3,3,20"
                                                                       Source="{Binding FullPath, Converter={StaticResource FilePathToImageSourceConverter}, ConverterParameter=220}"
                                                                       Stretch="Uniform" />
                                                                <Border VerticalAlignment="Bottom"
                                                                        Padding="5,3"
                                                                        Background="{DynamicResource App.OverlayBrush}">
                                                                    <TextBlock Foreground="White"
                                                                               FontSize="8"
                                                                               Text="{Binding Name}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <TextBlock Margin="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                                   FontSize="10"
                                                   Text="当前风格组尚未加入参考图片">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedStyleGroup.Assets.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Margin="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                                   FontSize="10"
                                                   Text="请先选择一个美术风格组">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedStyleGroup}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource GenerationCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,13">
                                <Border Style="{StaticResource GenerationStepBadgeStyle}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.AccentBrush}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Text="2" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource App.PanelHeaderStyle}"
                                               Text="描述内容与输出位置" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource GenerationMutedTextStyle}"
                                               Text="每行对应一个独立任务；可拖动列宽、行高与左右分隔条，并用 Ctrl+C 复制所选单元格。" />
                                </StackPanel>
                                <Button x:Name="AddGenerationRowButton"
                                        DockPanel.Dock="Right"
                                        Command="{Binding AddDraftRowCommand}"
                                        Content="＋ 新建行"
                                        Style="{StaticResource GenerationSmallButtonStyle}" />
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <TextBox x:Name="AssetGenerationContentPromptTextBox"
                                         Visibility="Collapsed"
                                         Text="{Binding ContentPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Visibility="Collapsed"
                                         Text="{Binding OutputDirectory, Mode=OneWay}" />
                                <TextBlock Visibility="Collapsed"
                                           Text="{Binding OutputDirectoryHint, Mode=OneWay}" />
                                <DataGrid x:Name="AssetGenerationRequestGrid"
                                          MinHeight="240"
                                          MaxHeight="480"
                                          Style="{StaticResource GenerationDataGridStyle}"
                                          FrozenColumnCount="1"
                                          LoadingRow="OnRequestGridLoadingRow"
                                          ItemsSource="{Binding DraftRows}"
                                          SelectedItem="{Binding SelectedDraftRow, Mode=TwoWay}"
                                          AlternationCount="2">
                                    <DataGrid.Resources>
                                        <Style TargetType="{x:Type DataGridColumnHeader}">
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="Background" Value="{DynamicResource App.SurfaceHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                                            <Setter Property="FontSize" Value="10" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                        <Style TargetType="{x:Type DataGridRow}">
                                            <Setter Property="MinHeight" Value="34" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="{x:Type DataGridCell}">
                                            <Setter Property="Padding" Value="4,2" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="物品描述"
                                                                Width="3*"
                                                                MinWidth="220"
                                                                ClipboardContentBinding="{Binding Description}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox MinHeight="30"
                                                             AcceptsReturn="True"
                                                             Padding="4,2"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="数量"
                                                                Width="72"
                                                                MinWidth="58"
                                                                MaxWidth="110"
                                                                ClipboardContentBinding="{Binding Quantity}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Padding="2"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             HorizontalContentAlignment="Center"
                                                             ToolTip="单行 1 到 16；更多产物请拆成多行"
                                                             Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="输出位置"
                                                                Width="3*"
                                                                MinWidth="240"
                                                                ClipboardContentBinding="{Binding OutputDirectory}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                                       FontSize="10"
                                                                       Text="{Binding OutputDirectory}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding OutputDirectory}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                                                       FontSize="9"
                                                                       Text="{Binding OutputDirectoryHint}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Width="34"
                                                                Height="28"
                                                                Margin="5,0,0,0"
                                                                Padding="0"
                                                                Command="{Binding DataContext.UseProjectCurrentDirectoryForRowCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                CommandParameter="{Binding}"
                                                                Content="当前"
                                                                FontSize="9"
                                                                ToolTip="使用 Project 面板当前目录" />
                                                        <Button Grid.Column="2"
                                                                Width="30"
                                                                Height="28"
                                                                Margin="4,0,0,0"
                                                                Padding="0"
                                                                Command="{Binding DataContext.ChooseRowOutputDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                CommandParameter="{Binding}"
                                                                Content="…"
                                                                FontSize="14"
                                                                ToolTip="选择该行输出目录" />
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="校验状态"
                                                                Width="1.4*"
                                                                MinWidth="120"
                                                                ClipboardContentBinding="{Binding ValidationMessage}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="9"
                                                               Foreground="{DynamicResource App.WarningBrush}"
                                                               Text="{Binding ValidationMessage}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ValidationMessage}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="操作" Width="48" MinWidth="48" MaxWidth="48" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Width="28"
                                                            Height="28"
                                                            Padding="0"
                                                            Command="{Binding DataContext.RemoveDraftRowCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            ToolTip="删除该物品"
                                                            Content="&#xE74D;" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="UseProjectOutputButton"
                                                Command="{Binding UseProjectCurrentDirectoryCommand}"
                                                Content="选中行使用项目目录"
                                                Style="{StaticResource GenerationSmallButtonStyle}" />
                                        <Button x:Name="ChooseGenerationOutputButton"
                                                Command="{Binding ChooseOutputDirectoryCommand}"
                                                Content="选择选中行目录…"
                                                Style="{StaticResource GenerationSmallButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource GenerationMutedTextStyle}"
                                               Text="{Binding BatchSummaryText}" />
                                </DockPanel>
                                         <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource GenerationFieldLabelStyle}"
                                               Text="整批共享负向提示词（可选）" />
                                <TextBox x:Name="AssetGenerationNegativePromptTextBox"
                                         MinHeight="54"
                                         AcceptsReturn="True"
                                         Text="{Binding NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource GenerationMetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                                   FontSize="9"
                                                   Text="TILEMAP 画幅" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding CanvasSizeText}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource GenerationMetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                                   FontSize="9"
                                                   Text="透视与几何" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding TilemapGeometryText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TilemapGeometryText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource GenerationCardStyle}" Margin="0">
                        <Grid>
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                         </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,11">
                                <Border Style="{StaticResource GenerationStepBadgeStyle}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.AccentBrush}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Text="3" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource App.PanelHeaderStyle}"
                                               Text="确认约束并开始生成" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource GenerationMutedTextStyle}"
                                               Text="开始生成会先写入可靠的本地队列，再由应用内 Agent 链路直接调度执行。" />
                                </StackPanel>
                            </DockPanel>

                            <TextBox x:Name="GenerationConstraintPreviewTextBox"
                                     Grid.Row="1"
                                     MinHeight="132"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     FontSize="10"
                                     Text="{Binding ConstraintPreview, Mode=OneWay}"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />

                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="{Binding ConnectionStatusText}" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource GenerationMutedTextStyle}"
                                           Text="连接正常后可直接在应用内生成，无需进入 CLI；未连接时仍可仅发布到本地队列。" />
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button x:Name="CreateGenerationTaskButton"
                                        MinWidth="116"
                                        Height="34"
                                        Command="{Binding CreateTaskCommand}"
                                        Style="{StaticResource GenerationSmallButtonStyle}"
                                        ToolTip="仅原子创建整批任务并写入本地队列，不立即请求 Agent 执行">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE7C3;" />
                                        <TextBlock VerticalAlignment="Center" Text="仅发布队列" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StartGenerationButton"
                                        MinWidth="148"
                                        Height="36"
                                        Margin="8,0,0,0"
                                        Padding="15,7"
                                        Background="{DynamicResource App.SelectionBrush}"
                                        BorderBrush="{DynamicResource App.AccentBrush}"
                                        Command="{Binding StartGenerationCommand}"
                                        FontWeight="SemiBold"
                                        ToolTip="发布当前批次并通过已连接的 Agent 在应用内直接开始生成">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,7,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE768;" />
                                        <TextBlock VerticalAlignment="Center" Text="开始生成" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource GenerationCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="RefreshGenerationTaskButton"
                                        DockPanel.Dock="Right"
                                        Command="{Binding RefreshTaskCommand}"
                                        Content="刷新状态"
                                        Style="{StaticResource GenerationSmallButtonStyle}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource App.PanelHeaderStyle}"
                                               Text="当前生成批次" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource GenerationMutedTextStyle}"
                                               Text="每行独立跟踪；失败行会以新批次和新交付路径重试。" />
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Padding="12,10"
                                    Background="{DynamicResource App.SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid x:Name="CurrentGenerationTaskDetails">
                                        <Grid.Style>
                                            <Style TargetType="{x:Type Grid}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCurrentTask}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                         </Grid.RowDefinitions>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left"
                                                    Padding="8,4"
                                                    Background="{DynamicResource App.SelectionBrush}"
                                                    BorderBrush="{DynamicResource App.AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <TextBlock Foreground="{DynamicResource App.AccentBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding CurrentTaskStatusText}" />
                                            </Border>
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                            <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                                       FontSize="9"
                                                       Text="主批次 ID" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Text="{Binding CurrentBatchId}"
                                                       TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding CurrentBatchId}" />
                                         </StackPanel>
                                         <Border Grid.Row="2"
                                                 Margin="0,10,0,0"
                                                 Padding="10,9"
                                                 Background="{DynamicResource App.InputBackgroundBrush}"
                                                 BorderBrush="{DynamicResource App.BorderBrush}"
                                                 BorderThickness="1"
                                                 CornerRadius="5">
                                             <Border.Style>
                                                 <Style TargetType="{x:Type Border}">
                                                     <Setter Property="Visibility" Value="Collapsed" />
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding HasDispatchProgress}" Value="True">
                                                             <Setter Property="Visibility" Value="Visible" />
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Border.Style>
                                             <StackPanel>
                                                 <DockPanel LastChildFill="True">
                                                     <TextBlock x:Name="GenerationDispatchProgressText"
                                                                DockPanel.Dock="Right"
                                                                Margin="10,0,0,0"
                                                                Foreground="{DynamicResource App.AccentBrush}"
                                                                FontFamily="Consolas"
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding DispatchProgressText}" />
                                                     <TextBlock x:Name="GenerationDispatchStageText"
                                                                Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding CurrentDispatchStageText}" />
                                                 </DockPanel>
                                                 <ProgressBar x:Name="GenerationDispatchProgressBar"
                                                              Height="7"
                                                              Margin="0,7,0,0"
                                                              Maximum="100"
                                                              Value="{Binding DispatchProgress, Mode=OneWay}" />
                                                 <TextBlock Margin="0,9,0,0"
                                                            Foreground="{DynamicResource App.TextMutedBrush}"
                                                            FontSize="8"
                                                            Text="当前执行指令" />
                                                 <TextBlock x:Name="GenerationCurrentInstructionText"
                                                            Margin="0,3,0,0"
                                                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                            FontFamily="Consolas"
                                                            FontSize="9"
                                                            Text="{Binding CurrentInstruction}"
                                                            TextWrapping="Wrap"
                                                            ToolTip="{Binding CurrentInstruction}" />
                                                 <TextBlock x:Name="GenerationDispatchStageDetailText"
                                                            Margin="0,5,0,0"
                                                            Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                            FontSize="9"
                                                            Text="{Binding DispatchStageDetail}"
                                                            TextWrapping="Wrap" />
                                                 <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                     <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                                                FontFamily="Consolas"
                                                                FontSize="8"
                                                                Text="{Binding CurrentStageElapsedText}" />
                                                     <TextBlock Margin="12,0,0,0"
                                                                Foreground="{DynamicResource App.TextMutedBrush}"
                                                                FontFamily="Consolas"
                                                                FontSize="8"
                                                                Text="{Binding LongestStageText}" />
                                                 </StackPanel>
                                                  <StackPanel Margin="0,7,0,0">
                                                      <StackPanel.Style>
                                                          <Style TargetType="{x:Type StackPanel}">
                                                             <Setter Property="Visibility" Value="Collapsed" />
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding HasDispatchFailure}" Value="True">
                                                                     <Setter Property="Visibility" Value="Visible" />
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </StackPanel.Style>
                                                     <TextBlock x:Name="GenerationDispatchFailureStageText"
                                                                Foreground="{DynamicResource App.DangerBrush}"
                                                                FontSize="9"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding FailureStageText, StringFormat=失败步骤：{0}}" />
                                                     <TextBlock x:Name="GenerationDispatchFailureText"
                                                                Margin="0,3,0,0"
                                                                Foreground="{DynamicResource App.DangerBrush}"
                                                                FontSize="9"
                                                                 Text="{Binding DispatchFailureText, StringFormat=原因：{0}}"
                                                                 TextWrapping="Wrap" />
                                                  </StackPanel>

                                                  <Border Margin="0,10,0,0"
                                                          Padding="9,8"
                                                          Background="{DynamicResource App.SurfaceBrush}"
                                                          BorderBrush="{DynamicResource App.BorderBrush}"
                                                          BorderThickness="1"
                                                          CornerRadius="4">
                                                      <StackPanel>
                                                          <DockPanel LastChildFill="True">
                                                              <TextBlock x:Name="GenerationImageProgressText"
                                                                         DockPanel.Dock="Right"
                                                                         Margin="10,0,0,0"
                                                                         Foreground="{DynamicResource App.AccentBrush}"
                                                                         FontFamily="Consolas"
                                                                         FontSize="10"
                                                                         FontWeight="SemiBold"
                                                                         Text="{Binding ImageProgressText}" />
                                                              <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                                         FontSize="10"
                                                                         FontWeight="SemiBold"
                                                                         Text="图片生成进度" />
                                                          </DockPanel>
                                                          <ProgressBar x:Name="GenerationImageProgressBar"
                                                                       Height="7"
                                                                       Margin="0,7,0,0"
                                                                       Maximum="100"
                                                                       Value="{Binding ImageProgress, Mode=OneWay}" />
                                                          <TextBlock x:Name="GenerationCurrentImageText"
                                                                     Margin="0,6,0,0"
                                                                     Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                                     FontFamily="Consolas, Microsoft YaHei UI"
                                                                     FontSize="9"
                                                                     Text="{Binding CurrentImageText}"
                                                                     TextWrapping="Wrap"
                                                                     ToolTip="{Binding CurrentImageText}" />

                                                          <Border Height="1"
                                                                  Margin="0,9,0,8"
                                                                  Background="{DynamicResource App.BorderBrush}" />

                                                          <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                                                     FontSize="8"
                                                                     Text="AGENT 实时状态" />
                                                          <TextBlock x:Name="GenerationAgentFeedbackStatusText"
                                                                     Margin="0,3,0,0"
                                                                     Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                                     FontFamily="Consolas, Microsoft YaHei UI"
                                                                     FontSize="9"
                                                                     Text="{Binding AgentFeedbackStatusText}"
                                                                     TextWrapping="Wrap" />

                                                          <Border x:Name="GenerationAgentRiskBorder"
                                                                  Margin="0,7,0,0"
                                                                  Padding="8,6"
                                                                  Background="{DynamicResource App.SurfaceRaisedBrush}"
                                                                  BorderBrush="{DynamicResource App.WarningBrush}"
                                                                  BorderThickness="2,0,0,0">
                                                              <Border.Style>
                                                                  <Style TargetType="{x:Type Border}">
                                                                      <Setter Property="Visibility" Value="Collapsed" />
                                                                      <Style.Triggers>
                                                                          <DataTrigger Binding="{Binding HasAgentGenerationRisk}" Value="True">
                                                                              <Setter Property="Visibility" Value="Visible" />
                                                                          </DataTrigger>
                                                                      </Style.Triggers>
                                                                  </Style>
                                                              </Border.Style>
                                                              <TextBlock x:Name="GenerationAgentGenerationRiskText"
                                                                         Foreground="{DynamicResource App.WarningBrush}"
                                                                         FontFamily="Consolas, Microsoft YaHei UI"
                                                                         FontSize="9"
                                                                         FontWeight="SemiBold"
                                                                         Text="{Binding AgentGenerationRiskText}"
                                                                         TextWrapping="Wrap" />
                                                          </Border>

                                                          <ListBox x:Name="GenerationAgentFeedbackList"
                                                                   MaxHeight="136"
                                                                   Margin="0,8,0,0"
                                                                   Padding="0"
                                                                   ItemsSource="{Binding AgentFeedbackEntries}"
                                                                   Background="Transparent"
                                                                   BorderThickness="0"
                                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                                   FontSize="9"
                                                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                   ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                              <ListBox.ItemContainerStyle>
                                                                  <Style TargetType="{x:Type ListBoxItem}">
                                                                      <Setter Property="Padding" Value="0" />
                                                                      <Setter Property="Margin" Value="0,0,0,3" />
                                                                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                      <Setter Property="IsHitTestVisible" Value="False" />
                                                                      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                  </Style>
                                                              </ListBox.ItemContainerStyle>
                                                              <ListBox.ItemTemplate>
                                                                  <DataTemplate>
                                                                      <Border Padding="6,4"
                                                                              Background="{DynamicResource App.InputBackgroundBrush}"
                                                                              BorderBrush="{DynamicResource App.BorderBrush}"
                                                                              BorderThickness="1"
                                                                              CornerRadius="3">
                                                                          <Grid>
                                                                              <Grid.ColumnDefinitions>
                                                                                  <ColumnDefinition Width="Auto" />
                                                                                  <ColumnDefinition Width="Auto" />
                                                                                  <ColumnDefinition Width="*" />
                                                                              </Grid.ColumnDefinitions>
                                                                              <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                                                                         Text="{Binding TimestampText}" />
                                                                              <TextBlock Grid.Column="1"
                                                                                         Margin="7,0,0,0"
                                                                                         Foreground="{DynamicResource App.AccentBrush}"
                                                                                         FontWeight="SemiBold"
                                                                                         Text="{Binding CategoryText, StringFormat=[{0}]}" />
                                                                              <TextBlock Grid.Column="2"
                                                                                         Margin="8,0,0,0"
                                                                                         Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                                                         Text="{Binding Message}"
                                                                                         TextWrapping="Wrap" />
                                                                          </Grid>
                                                                      </Border>
                                                                  </DataTemplate>
                                                              </ListBox.ItemTemplate>
                                                          </ListBox>
                                                      </StackPanel>
                                                  </Border>
                                              </StackPanel>
                                          </Border>
                                         <TextBlock Grid.Row="3"
                                                    Margin="0,10,0,0"
                                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                    FontSize="10"
                                                    Text="{Binding CurrentTaskDetail}"
                                                    TextWrapping="Wrap" />
                                         <ScrollViewer Grid.Row="4"
                                                       MaxHeight="280"
                                                       Margin="0,10,0,0"
                                                       VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="PublishedGenerationTaskList"
                                                          ItemsSource="{Binding PublishedTasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,7"
                                                                Padding="9,7"
                                                                Background="{DynamicResource App.InputBackgroundBrush}"
                                                                BorderBrush="{DynamicResource App.BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right"
                                                                            Margin="8,0,0,0"
                                                                            Padding="8,2"
                                                                            Command="{Binding DataContext.RetryFailedTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="重试失败项"
                                                                            FontSize="9">
                                                                        <Button.Style>
                                                                            <Style TargetType="{x:Type Button}"
                                                                                   BasedOn="{StaticResource App.ButtonStyle}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <TextBlock Foreground="{DynamicResource App.AccentBrush}"
                                                                               FontSize="9"
                                                                               FontWeight="SemiBold"
                                                                               Text="{Binding StatusText}" />
                                                                </DockPanel>
                                                                <TextBlock Grid.Row="1"
                                                                           Margin="0,4,0,0"
                                                                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding Description}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Description}" />
                                                                <TextBlock Grid.Row="2"
                                                                           Margin="0,3,0,0"
                                                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                                                           FontSize="9"
                                                                           Text="{Binding DetailText}"
                                                                           TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                         </ScrollViewer>

                                         <Border Grid.Row="5"
                                                 Margin="0,10,0,0"
                                                 Padding="10,9"
                                                 Background="{DynamicResource App.InputBackgroundBrush}"
                                                 BorderBrush="{DynamicResource App.BorderBrush}"
                                                 BorderThickness="1"
                                                 CornerRadius="5">
                                             <Grid>
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                 </Grid.RowDefinitions>
                                                 <DockPanel>
                                                     <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Text="Codex 人工接力" />
                                                     <TextBlock Margin="8,0,0,0"
                                                                HorizontalAlignment="Right"
                                                                Foreground="{DynamicResource App.TextMutedBrush}"
                                                                FontSize="8"
                                                                Text="提示不包含 Bearer Token 明文" />
                                                 </DockPanel>
                                                 <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                                     <Button x:Name="CopyCodexConnectionPromptButton"
                                                             MinWidth="132"
                                                             Margin="0,0,7,7"
                                                             Padding="9,4"
                                                             Click="OnCopyCodexConnectionPromptClick"
                                                             Content="复制 Codex 连接指令"
                                                             IsEnabled="{Binding CanCopyCodexConnectionPrompt}"
                                                             FontSize="9" />
                                                     <Button x:Name="CopyCurrentBatchPromptButton"
                                                             MinWidth="142"
                                                             Margin="0,0,7,7"
                                                             Padding="9,4"
                                                             Click="OnCopyCurrentBatchPromptClick"
                                                             Content="复制当前批次任务指令"
                                                             IsEnabled="{Binding CanCopyCurrentBatchPrompt}"
                                                             FontSize="9" />
                                                     <Button x:Name="CreateManualRetryBatchButton"
                                                             MinWidth="132"
                                                             Margin="0,0,0,7"
                                                             Padding="9,4"
                                                             Command="{Binding CreateManualRetryBatchCommand}"
                                                             Content="创建手动重试批次"
                                                             FontSize="9" />
                                                 </WrapPanel>
                                                 <TextBlock Grid.Row="2"
                                                            Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                            FontSize="9"
                                                            Text="{Binding ManualFallbackAvailabilityText}"
                                                            TextWrapping="Wrap" />
                                                 <TextBox x:Name="CodexManualFallbackPromptPreviewTextBox"
                                                          Grid.Row="3"
                                                          MinHeight="128"
                                                          MaxHeight="260"
                                                          Margin="0,8,0,0"
                                                          IsReadOnly="True"
                                                          AcceptsReturn="True"
                                                          AcceptsTab="True"
                                                          FontFamily="Consolas, Microsoft YaHei UI"
                                                          FontSize="9"
                                                          Text="{Binding ManualFallbackPromptPreview, Mode=OneWay}"
                                                          TextWrapping="Wrap"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto" />
                                                 <TextBlock Grid.Row="4"
                                                            Margin="0,7,0,0"
                                                            Foreground="{DynamicResource App.AccentBrush}"
                                                            FontSize="9"
                                                            Text="{Binding ManualFallbackStatusText}"
                                                            TextWrapping="Wrap" />
                                             </Grid>
                                         </Border>
                                     </Grid>

                                    <StackPanel Margin="14"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCurrentTask}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="26"
                                                   Text="&#xE8A5;" />
                                        <TextBlock Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                   FontSize="10"
                                                   Text="尚未发布生成批次" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="2"
                                       Margin="0,9,0,0"
                                       Style="{StaticResource GenerationMutedTextStyle}"
                                       Text="{Binding StatusText}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource GenerationCardStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="300" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                           FontSize="9"
                                           Text="{Binding GeneratedAssets.Count, StringFormat={}{0} 个文件}" />
                                <TextBlock Style="{StaticResource App.PanelHeaderStyle}"
                                           Text="生成产物" />
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <ListBox x:Name="GeneratedAssetList"
                                         ItemsSource="{Binding GeneratedAssets}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource GenerationAssetListItemStyle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="94" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Margin="5,5,5,0"
                                                        Background="{DynamicResource App.InputBackgroundBrush}"
                                                        CornerRadius="4"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="24"
                                                                   Text="&#xEB9F;" />
                                                        <Image Source="{Binding FullPath, Converter={StaticResource FilePathToImageSourceConverter}, ConverterParameter=300}"
                                                               Stretch="Uniform"
                                                               ToolTip="{Binding FullPath}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="8,6,8,5">
                                                    <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FullPath}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                                               FontSize="8"
                                                               Text="{Binding AvailabilityText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding RelativePath}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Margin="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GeneratedAssets.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="30"
                                               Text="&#xE7C3;" />
                                     <TextBlock Margin="0,8,0,0"
                                                HorizontalAlignment="Center"
                                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                FontSize="10"
                                                Text="Agent 输出文件落盘后会显示在这里；完成登记前会标记为待回写" />
                                </StackPanel>
                            </Grid>

                            <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding OpenOutputDirectoryCommand}"
                                        Content="打开输出目录"
                                        Style="{StaticResource GenerationSmallButtonStyle}" />
                                <TextBlock Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                           FontSize="9"
                                           Text="{Binding OutputDirectory}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding OutputDirectory}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="9,0"
                Background="{DynamicResource App.SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,7,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.AccentBrush}"
                           FontSize="8"
                           Text="●" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="9"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}" />
            </DockPanel>
        </Border>

        <Border Grid.RowSpan="3"
                Panel.ZIndex="20"
                Background="{DynamicResource App.OverlayBrush}"
                IsHitTestVisible="True">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="220"
                    Padding="18,15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource App.SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource App.AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource App.AccentBrush}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Text="&#xE895;" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               Text="正在处理生成任务…" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
