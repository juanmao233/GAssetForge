<UserControl x:Class="GAssetForge.App.Views.AgentConnectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GAssetForge.App.ViewModels"
        MinWidth="320"
        MinHeight="260">
    <UserControl.Resources>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource App.ButtonStyle}" />
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource App.TextBoxStyle}" />
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource App.ComboBoxStyle}" />
        <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource App.GroupBoxStyle}" />

        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StatusValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StatusCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource App.CardStyle}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ConnectionStatusDotStyle" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="Fill" Value="{DynamicResource App.TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:AgentConnectionStatus.Starting}">
                    <Setter Property="Fill" Value="{DynamicResource App.WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:AgentConnectionStatus.WaitingForAgent}">
                    <Setter Property="Fill" Value="{DynamicResource App.WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:AgentConnectionStatus.Connected}">
                    <Setter Property="Fill" Value="{DynamicResource App.SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:AgentConnectionStatus.Stopping}">
                    <Setter Property="Fill" Value="{DynamicResource App.WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:AgentConnectionStatus.Faulted}">
                    <Setter Property="Fill" Value="{DynamicResource App.DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StartStopButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.ButtonStyle}">
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Command" Value="{Binding StartCommand}" />
            <Setter Property="Content" Value="启动 Agent 会话" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAgentSessionActive}" Value="True">
                    <Setter Property="Command" Value="{Binding StopCommand}" />
                    <Setter Property="Content" Value="停止 Agent 会话" />
                    <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="AgentConnectionRootGrid"
          Background="{DynamicResource App.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Border x:Name="AgentHeaderBorder"
                Padding="20,15"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="ServerToggleButton"
                        DockPanel.Dock="Right"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource StartStopButtonStyle}" />
                <Border DockPanel.Dock="Left"
                        Width="44"
                        Height="44"
                        Margin="0,0,13,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource App.SelectionBrush}"
                        BorderBrush="{DynamicResource App.AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource App.AccentBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               Text="AGT" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Agent 会话与 MCP 接入"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource App.TextSecondaryBrush}"
                               Text="由桌面端管理 Codex 持久线程、认证、MCP 工具状态与任务 Turn。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="AgentSettingsScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="Both"
                      PreviewMouseWheel="AgentSettingsScrollViewer_OnPreviewMouseWheel">
            <Border x:Name="AgentSettingsViewportContent"
                    Width="{Binding ViewportWidth, ElementName=AgentSettingsScrollViewer}"
                    MinWidth="620"
                    Padding="18,16,18,10">
                <StackPanel x:Name="AgentSettingsContent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="会话设置">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="连接 Agent" />
                                <ComboBox x:Name="AgentSelectorComboBox"
                                          ItemsSource="{Binding Agents}"
                                          SelectedItem="{Binding SelectedAgent, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding CanEditSettings}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="MCP 端口" />
                                <TextBox x:Name="McpPortTextBox"
                                         Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding CanEditSettings}"
                                         HorizontalContentAlignment="Right" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Agent 工作目录" />
                                <TextBox IsReadOnly="True"
                                         FontFamily="Consolas, Microsoft YaHei UI"
                                         Text="{Binding WorkingDirectory, Mode=OneWay}"
                                         ToolTip="当前项目目录；线程仅会在同一工作目录中恢复" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="MCP Endpoint" />
                                <TextBox x:Name="McpEndpointTextBox"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Microsoft YaHei UI"
                                         Text="{Binding Endpoint, Mode=OneWay}" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="{Binding SelectedAgent.Description}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="MCP Server 独立控制" />
                                <WrapPanel>
                                    <Button x:Name="StartMcpServerButton"
                                            MinWidth="112"
                                            Margin="0,0,8,8"
                                            Command="{Binding StartMcpServerCommand}"
                                            Content="仅启动 MCP" />
                                    <Button x:Name="StopMcpServerButton"
                                            MinWidth="112"
                                            Margin="0,0,8,8"
                                            Command="{Binding StopMcpServerCommand}"
                                            Content="停止 MCP" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="可在 Codex Runtime 不可用时单独验证端口、健康检查与外部 MCP 客户端握手。" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="认证与运行时">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="Codex CLI" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,5"
                                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                                           Text="{Binding CodexVersionText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="认证" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,0,0,5"
                                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                                           Text="{Binding AuthenticationText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="运行方式" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="12,0,0,5"
                                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                                           Text="{Binding RuntimeModeText}" TextWrapping="Wrap" />
                            </Grid>

                            <WrapPanel Margin="0,12,0,0">
                                <Button MinWidth="86"
                                        Margin="0,0,8,8"
                                        Command="{Binding LoginCommand}"
                                        Content="登录" />
                                <Button MinWidth="96"
                                        Margin="0,0,8,8"
                                        Command="{Binding RefreshAuthenticationCommand}"
                                        Content="刷新认证" />
                                <Button MinWidth="96"
                                        Margin="0,0,0,8"
                                        Command="{Binding InterruptTurnCommand}"
                                        Content="中断 Turn" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                       Text="登录采用 Codex App Server 的设备授权流程；完成浏览器授权后刷新认证。" />
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <GroupBox x:Name="CodexExecutableGroupBox"
                          Margin="0,12,0,0"
                          Header="Codex CLI 路径与探测">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="当前启动路径" />
                        <TextBox x:Name="CodexExecutablePathTextBox"
                                 IsReadOnly="True"
                                 FontFamily="Consolas, Microsoft YaHei UI"
                                 Text="{Binding CodexExecutablePathDisplayText, Mode=OneWay}"
                                 ToolTip="{Binding CodexExecutablePathDisplayText}" />
                        <WrapPanel Margin="0,9,0,0">
                            <Button x:Name="BrowseCodexExecutableButton"
                                    MinWidth="104"
                                    Margin="0,0,8,8"
                                    Command="{Binding BrowseCodexExecutableCommand}"
                                    Content="浏览路径…" />
                            <Button x:Name="UseAutomaticCodexExecutableButton"
                                    MinWidth="116"
                                    Margin="0,0,8,8"
                                    Command="{Binding UseAutomaticCodexExecutableCommand}"
                                    Content="恢复自动检测" />
                            <Button x:Name="RefreshCodexRuntimeDiagnosticsButton"
                                    MinWidth="104"
                                    Margin="0,0,8,8"
                                    Command="{Binding RefreshCodexRuntimeDiagnosticsCommand}"
                                    Content="重新检测" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="自动检测会优先检查 %APPDATA%\npm 下的官方 shim；显式路径支持 .cmd、.bat 与 .exe。" />
                        <Expander x:Name="CodexRuntimeDiagnosticsExpander"
                                  Margin="0,9,0,0"
                                  Header="候选路径与失败原因"
                                  IsExpanded="True">
                            <TextBox x:Name="CodexRuntimeDiagnosticsTextBox"
                                     Margin="0,7,0,0"
                                     MinHeight="76"
                                     MaxHeight="180"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     FontSize="11"
                                     Text="{Binding CodexRuntimeDiagnosticsText, Mode=OneWay}"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </GroupBox>

                <Border Margin="0,12,0,0"
                        Padding="13,11"
                        Background="{DynamicResource App.SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource ConnectionStatusDotStyle}" />
                            <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       Text="总体状态" />
                        </StackPanel>
                        <TextBlock x:Name="ServerStatusTextBlock"
                                   Margin="18,0,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding StatusText}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding StatusText}" />
                    </DockPanel>
                </Border>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource StatusCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="App Server / Runtime" />
                            <TextBlock Style="{StaticResource StatusValueStyle}"
                                       Text="{Binding AppServerStatusText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatusCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="MCP Server" />
                            <TextBlock Style="{StaticResource StatusValueStyle}"
                                       Text="{Binding McpServerStatusText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatusCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="MCP 工具" />
                            <TextBlock x:Name="HandshakeStatusTextBlock"
                                       Style="{StaticResource StatusValueStyle}"
                                       Text="{Binding McpToolStatusText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource StatusCardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="Turn" />
                            <TextBlock Style="{StaticResource StatusValueStyle}"
                                       Text="{Binding TurnStatusText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource StatusCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="持久线程 ID" />
                            <TextBlock Style="{StaticResource StatusValueStyle}"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       Text="{Binding ThreadIdText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ThreadIdText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatusCardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="最近 MCP 握手" />
                            <TextBlock Style="{StaticResource StatusValueStyle}"
                                       Text="{Binding LastHandshakeText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LastHandshakeText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Expander Margin="0,10,0,0"
                          Header="MCP 参考配置（诊断用，不含认证令牌）"
                          IsExpanded="True">
                    <Border Margin="0,8,0,0"
                            Padding="10"
                            Background="{DynamicResource App.SurfaceBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ConfigSnippetTextBox"
                                     MinHeight="78"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     FontSize="12"
                                     Text="{Binding ConfigSnippet, Mode=OneWay}"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
                            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right"
                                        MinWidth="92"
                                        Command="{Binding CopyConfigCommand}"
                                        Content="复制配置" />
                                <TextBlock Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="正式连接由桌面端自动配置；此文本只用于排查 CLI 配置。" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Expander>

                <Expander x:Name="CodexManualConnectionExpander"
                          Margin="0,10,0,0"
                          Header="Codex 手工连接指令（聊天接力）"
                          IsExpanded="False">
                    <Border Margin="0,8,0,0"
                            Padding="10"
                            Background="{DynamicResource App.SurfaceBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="CodexConnectionPromptTextBox"
                                     MinHeight="124"
                                     MaxHeight="260"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     FontSize="11"
                                     Text="{Binding CodexConnectionPrompt, Mode=OneWay}"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
                            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button x:Name="CopyCodexConnectionPromptButton"
                                        DockPanel.Dock="Right"
                                        MinWidth="142"
                                        Command="{Binding CopyCodexConnectionPromptCommand}"
                                        Content="复制 Codex 连接指令" />
                                <TextBlock Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="{Binding CodexConnectionPromptStatusText}"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Expander>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border x:Name="AgentLogPanel"
                Grid.Row="2"
                Margin="18,0,18,16"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="13,9"
                        Background="{DynamicResource App.SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                MinWidth="82"
                                Padding="10,5"
                                Command="{Binding ClearLogCommand}"
                                Content="清空日志" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="实时日志" />
                            <TextBlock Margin="10,0,0,0"
                                       Style="{StaticResource App.StatusTextStyle}"
                                       Text="Runtime、认证、线程、Turn 与 MCP 状态；敏感令牌已脱敏" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ListBox x:Name="LogListBox"
                         Grid.Row="1"
                         ItemsSource="{Binding Logs}"
                         Background="{DynamicResource App.InputBackgroundBrush}"
                         BorderThickness="0"
                         Foreground="{DynamicResource App.TextSecondaryBrush}"
                         FontFamily="Consolas, Microsoft YaHei UI"
                         FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="12,5" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="NoWrap"
                                       TextOptions.TextFormattingMode="Display" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1"
                           Margin="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           Text="启动 Agent 会话后，运行日志将在这里显示。">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
