<UserControl x:Class="GAssetForge.App.Views.ArtWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GAssetForge.App.Converters"
             xmlns:viewModels="clr-namespace:GAssetForge.App.ViewModels"
             MinWidth="680"
             MinHeight="420"
             Unloaded="ArtWorkspaceView_OnUnloaded">
    <UserControl.Resources>
        <conv:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />
        <conv:StringToBrushConverter x:Key="StringToBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DrawingBrush x:Key="ArtWorkspaceGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,32,32"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,32,32"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource App.CanvasBackgroundBrush}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource App.BorderBrush}" Thickness="0.65" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,32,32" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="ArtWorkspaceImageCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
                    <Setter Property="BorderThickness" Value="3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,0"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Padding="8,4"
                            Background="{DynamicResource App.InputBackgroundBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="10"
                                   Text="滚轮缩放 · 中/右键平移 · 图片可拖放" />
                    </Border>
                    <Button x:Name="ArtWorkspaceImportImagesButton"
                            Margin="8,0,0,0"
                            Padding="10,5"
                            Command="{Binding ImportImagesCommand}"
                            Content="导入图片"
                            Style="{DynamicResource App.ButtonStyle}" />
                    <Button Margin="8,0,0,0"
                            Padding="10,5"
                            Command="{Binding CancelImportCommand}"
                            Content="取消导入"
                            Style="{DynamicResource App.ButtonStyle}"
                            Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="ArtWorkspaceFocusAllButton"
                            Margin="8,0,0,0"
                            Padding="10,5"
                            Click="FocusAll_OnClick"
                            Content="聚焦全部"
                            Style="{DynamicResource App.ButtonStyle}" />
                    <Button Margin="8,0,0,0"
                            Padding="10,5"
                            Command="{Binding SaveCommand}"
                            Content="保存工作区"
                            Style="{DynamicResource App.ButtonStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28"
                            Height="28"
                            Margin="0,0,9,0"
                            Background="{DynamicResource App.AccentBrush}"
                            CornerRadius="5">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="15"
                                   Text="✦" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding Header}" />
                        <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="9"
                                   Text="{Binding Description}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="ArtWorkspaceViewport"
              Grid.Row="1"
              AllowDrop="True"
              Background="{DynamicResource App.CanvasBackgroundBrush}"
              ClipToBounds="True"
              Focusable="True"
              PreviewDragOver="ArtWorkspaceViewport_OnPreviewDragOver"
              PreviewDrop="ArtWorkspaceViewport_OnPreviewDrop"
              PreviewKeyDown="ArtWorkspaceViewport_OnPreviewKeyDown"
              PreviewMouseDown="ArtWorkspaceViewport_OnPreviewMouseDown"
              PreviewMouseMove="ArtWorkspaceViewport_OnPreviewMouseMove"
              PreviewMouseUp="ArtWorkspaceViewport_OnPreviewMouseUp"
              PreviewMouseWheel="ArtWorkspaceViewport_OnPreviewMouseWheel"
              LostMouseCapture="ArtWorkspaceViewport_OnLostMouseCapture">
            <Canvas x:Name="ArtWorkspaceWorld"
                    Width="{Binding CanvasWidth}"
                    Height="{Binding CanvasHeight}">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                        <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <Rectangle Width="{Binding CanvasWidth}"
                           Height="{Binding CanvasHeight}"
                           Fill="{StaticResource ArtWorkspaceGridBrush}"
                           IsHitTestVisible="False" />

                <ItemsControl x:Name="ArtWorkspaceImageItems"
                              Width="{Binding CanvasWidth}"
                              Height="{Binding CanvasHeight}"
                              ItemsSource="{Binding Images}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="{x:Type ContentPresenter}">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ArtWorkspaceImageItemViewModel}">
                            <Border x:Name="ArtWorkspaceImageCard"
                                    Width="{Binding Width}"
                                    Height="{Binding Height}"
                                    Opacity="{Binding Opacity}"
                                    PreviewMouseLeftButtonDown="ImageCard_OnPreviewMouseLeftButtonDown"
                                    Style="{StaticResource ArtWorkspaceImageCardStyle}">
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="{Binding RotationDegrees}" />
                                    </Grid.RenderTransform>
                                    <Image Source="{Binding AbsolutePath, Converter={StaticResource FilePathToImageSourceConverter}, ConverterParameter=640}"
                                           Stretch="Fill"
                                           SnapsToDevicePixels="True" />
                                    <Border VerticalAlignment="Top"
                                            Padding="6,3"
                                            Background="#AA11151C">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Margin="8,0,0,0"
                                                       Foreground="#BFFFFFFF"
                                                       FontSize="9"
                                                       Text="{Binding PixelSizeText}" />
                                            <TextBlock Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                    <Border Background="#CC311A1A"
                                            Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       Text="!" />
                                            <TextBlock Margin="8,3"
                                                       Foreground="White"
                                                       Text="受管图片缺失"
                                                       TextAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid x:Name="ArtWorkspaceOutputFrame"
                      Canvas.Left="{Binding OutputFrameX}"
                      Canvas.Top="{Binding OutputFrameY}"
                      Panel.ZIndex="1000001"
                      Width="{Binding OutputFrameWidth}"
                      Height="{Binding OutputFrameHeight}"
                      Cursor="SizeAll"
                      PreviewMouseLeftButtonDown="OutputFrame_OnPreviewMouseLeftButtonDown">
                    <Border Background="{Binding OutputBackgroundHex, Converter={StaticResource StringToBrushConverter}, ConverterParameter=#20242C}"
                             Opacity="0.14"
                             BorderBrush="{DynamicResource App.AccentBrush}"
                            BorderThickness="2" />
                    <Rectangle Margin="5"
                               Stroke="{DynamicResource App.AccentBrush}"
                               StrokeDashArray="8,5"
                               StrokeThickness="2"
                               IsHitTestVisible="False" />
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10"
                            Padding="8,5"
                            Background="#D9121720"
                            BorderBrush="{DynamicResource App.AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            IsHitTestVisible="False">
                        <StackPanel>
                            <TextBlock Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="{Binding OutputFrameName}" />
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="#CFFFFFFF"
                                       FontSize="9"
                                       Text="{Binding OutputFrameSummary}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ArtWorkspaceOutputResizeHandle"
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,-4,-4"
                            Background="{DynamicResource App.AccentBrush}"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="3"
                            Cursor="SizeNWSE"
                            PreviewMouseLeftButtonDown="OutputResizeHandle_OnPreviewMouseLeftButtonDown" />
                </Grid>
            </Canvas>

            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="12"
                    Padding="9,6"
                    Background="#D9121720"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    IsHitTestVisible="False">
                <TextBlock Foreground="#DFFFFFFF"
                           FontSize="10"
                           Text="将 PNG/JPG/WebP 等图片拖入画布；单击选择、左拖移动、Delete 移除引用。" />
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="10,0"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="9"
                           Text="{Binding PersistenceText}" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="9"
                           Text="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
