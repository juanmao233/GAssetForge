<UserControl x:Class="GAssetForge.App.Views.CommandConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:services="clr-namespace:GAssetForge.App.Services"
             MinWidth="620"
             MinHeight="260">
    <UserControl.Resources>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource App.ButtonStyle}" />
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource App.TextBoxStyle}" />
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource App.CheckBoxStyle}" />

        <Style x:Key="ConsoleToolbarButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource App.ToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <Style x:Key="ConsoleFilterStyle"
               TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource App.CheckBoxStyle}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ConsoleColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="ConsoleCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConsoleRowStyle" TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{DynamicResource App.InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="ToolTip" Value="{Binding DetailsSummary}" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:WorkbenchLogLevel.Error}">
                    <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
                    <Setter Property="BorderThickness" Value="2,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:WorkbenchLogLevel.Warning}">
                    <Setter Property="BorderBrush" Value="{DynamicResource App.WarningBrush}" />
                    <Setter Property="BorderThickness" Value="2,0,0,0" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConsoleTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ConsoleLevelTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource ConsoleTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:WorkbenchLogLevel.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource App.SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:WorkbenchLogLevel.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource App.WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:WorkbenchLogLevel.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource App.DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:WorkbenchLogLevel.Command}">
                    <Setter Property="Foreground" Value="{DynamicResource App.AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="9,5"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid Width="185" Height="28">
                        <TextBox x:Name="LogSearchTextBox"
                                 Padding="26,4,7,4"
                                 automation:AutomationProperties.Name="搜索指令日志"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="9,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="12"
                                   IsHitTestVisible="False"
                                   Text="⌕" />
                        <TextBlock Margin="27,0,7,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="11"
                                   IsHitTestVisible="False"
                                   Text="搜索来源、消息或详情">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Style="{StaticResource ConsoleToolbarButtonStyle}"
                            Command="{Binding OpenLogDirectoryCommand}"
                            Content="日志目录"
                            ToolTip="{Binding LogDirectory}" />
                    <Button Style="{StaticResource ConsoleToolbarButtonStyle}"
                            Command="{Binding ClearDisplayCommand}"
                            Content="清空" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource ConsoleFilterStyle}"
                              IsChecked="{Binding ShowInformation, Mode=TwoWay}"
                              Content="{Binding InformationFilterLabel}" />
                    <CheckBox Style="{StaticResource ConsoleFilterStyle}"
                              IsChecked="{Binding ShowWarnings, Mode=TwoWay}"
                              Content="{Binding WarningFilterLabel}" />
                    <CheckBox Style="{StaticResource ConsoleFilterStyle}"
                              IsChecked="{Binding ShowErrors, Mode=TwoWay}"
                              Content="{Binding ErrorFilterLabel}" />
                    <CheckBox Style="{StaticResource ConsoleFilterStyle}"
                              IsChecked="{Binding ShowCommands, Mode=TwoWay}"
                              Content="{Binding CommandFilterLabel}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="LogDataGrid"
                  Grid.Row="1"
                  automation:AutomationProperties.Name="工作台日志列表"
                  ItemsSource="{Binding FilteredEntries}"
                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserResizeRows="True"
                  CanUserSortColumns="True"
                  AlternationCount="2"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource App.BorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource App.BorderBrush}"
                  Background="{DynamicResource App.InputBackgroundBrush}"
                  Foreground="{DynamicResource App.TextSecondaryBrush}"
                  BorderThickness="0"
                  RowStyle="{StaticResource ConsoleRowStyle}"
                  CellStyle="{StaticResource ConsoleCellStyle}"
                  ColumnHeaderStyle="{StaticResource ConsoleColumnHeaderStyle}"
                  ColumnHeaderHeight="29"
                  RowHeight="26"
                  MinRowHeight="24"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ClipboardCopyMode="IncludeHeader"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间"
                                    Width="104"
                                    MinWidth="82"
                                    Binding="{Binding TimestampText}"
                                    ElementStyle="{StaticResource ConsoleTextStyle}" />
                <DataGridTemplateColumn Header="类型" Width="88" MinWidth="68"
                                        ClipboardContentBinding="{Binding LevelText}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="15"
                                           Style="{StaticResource ConsoleLevelTextStyle}"
                                           Text="{Binding LevelGlyph}" />
                                <TextBlock Style="{StaticResource ConsoleLevelTextStyle}"
                                           Text="{Binding LevelText}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="来源"
                                    Width="140"
                                    MinWidth="80"
                                    Binding="{Binding Source}"
                                    ElementStyle="{StaticResource ConsoleTextStyle}" />
                <DataGridTextColumn Header="消息"
                                    Width="2.5*"
                                    MinWidth="220"
                                    Binding="{Binding Message}"
                                    ElementStyle="{StaticResource ConsoleTextStyle}" />
                <DataGridTextColumn Header="详细信息"
                                    Width="1.2*"
                                    MinWidth="120"
                                    Binding="{Binding DetailsSummary}"
                                    ClipboardContentBinding="{Binding ExportText}"
                                    ElementStyle="{StaticResource ConsoleTextStyle}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Padding="9,0"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,1">
            <DockPanel LastChildFill="True">
                <CheckBox DockPanel.Dock="Right"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                          Content="自动滚动" />
                <TextBlock DockPanel.Dock="Right"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="10"
                           Text="列头可拖动排序 · 列边界可调整宽度"
                           ToolTip="行下边界也可调整高度；Ctrl+C 可复制选中日志" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="10"
                           Text="{Binding StatusText}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="10"
                           Text="{Binding PersistenceStatusText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SessionLogPath}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Padding="8,5"
                Background="{DynamicResource App.InputBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.AccentBrush}"
                           FontFamily="Consolas"
                           FontSize="16"
                           FontWeight="Bold"
                           Text=">" />

                <Grid Grid.Column="1">
                    <TextBox x:Name="CommandInputTextBox"
                             MinHeight="30"
                             Padding="7,4"
                             automation:AutomationProperties.Name="工作台命令输入"
                             AcceptsReturn="False"
                             FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="12"
                             Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="CommandInput_OnPreviewKeyDown" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMutedBrush}"
                               FontSize="11"
                               IsHitTestVisible="False"
                               Text="输入 help 查看白名单命令 · Enter 执行 · ↑/↓ 历史">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InputText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="2"
                        MinWidth="70"
                        Height="30"
                        Margin="7,0,0,0"
                        Padding="10,4"
                        Command="{Binding ExecuteCommandCommand}"
                        Content="执行" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
