<UserControl x:Class="GAssetForge.App.Views.BackgroundRemovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GAssetForge.App.Converters"
             xmlns:controls="clr-namespace:GAssetForge.App.Controls"
             MinWidth="460"
             MinHeight="330"
             Background="{DynamicResource App.BackgroundBrush}">
    <UserControl.Resources>
        <conv:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DrawingBrush x:Key="TransparencyCheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,20,20"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFB9BDC4">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,20,20" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFE1E3E7">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,10,10" />
                                <RectangleGeometry Rect="10,10,10,10" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="BackgroundRemovalPreviewCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource App.CardStyle}">
            <Setter Property="Padding" Value="10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource App.ImageToolHeaderStyle}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="9"
                           Text="左键标尺 · 滚轮缩放 · 中键平移 · 右键复位" />
                <StackPanel>
                    <TextBlock Style="{StaticResource App.ImageToolTitleStyle}"
                               Text="背景剔除工具" />
                    <TextBlock Style="{StaticResource App.ImageToolSubtitleStyle}"
                               Text="色键、假透明与批量操作已集中到属性面板" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource BackgroundRemovalPreviewCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="原图" />
                        <Border Grid.Row="1"
                                Margin="0,8,0,6"
                                BorderBrush="{DynamicResource App.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                ClipToBounds="True">
                            <controls:CheckerGridImagePreviewControl
                                x:Name="BackgroundRemovalInputPreview"
                                Source="{Binding InputPath, Converter={StaticResource FilePathToImageSourceConverter}, ConverterParameter=1600}"
                                SourcePixelWidth="{Binding SourcePixelWidth}"
                                SourcePixelHeight="{Binding SourcePixelHeight}"
                                ShowGrid="{Binding ShowCheckerGridOverlay}"
                                CellSize="{Binding CheckerCellSize, Mode=TwoWay}"
                                OffsetX="{Binding CheckerOffsetX, Mode=TwoWay}"
                                OffsetY="{Binding CheckerOffsetY, Mode=TwoWay}"
                                IsRulerEditingEnabled="{Binding ShowCheckerGridOverlay}"
                                RulerEditStarted="BackgroundRemovalInputPreview_OnRulerEditStarted"
                                RulerEditCompleted="BackgroundRemovalInputPreview_OnRulerEditCompleted"
                                RulerEditCanceled="BackgroundRemovalInputPreview_OnRulerEditCanceled"
                                Background="{DynamicResource App.InputBackgroundBrush}"
                                BitmapScalingMode="HighQuality"
                                PlaceholderForeground="{DynamicResource App.TextMutedBrush}"
                                PlaceholderText="选择图片后在此预览"
                                ViewportPadding="8" />
                        </Border>
                        <TextBlock Grid.Row="2"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="9"
                                   Text="{Binding InputPath}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding InputPath}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource BackgroundRemovalPreviewCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.AccentBrush}"
                                       FontSize="9"
                                       Text="{Binding ResultSummary}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="透明结果" />
                        </DockPanel>
                        <Border Grid.Row="1"
                                Margin="0,8,0,6"
                                BorderBrush="{DynamicResource App.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                ClipToBounds="True">
                            <controls:ImagePreviewControl
                                x:Name="BackgroundRemovalOutputPreview"
                                Source="{Binding OutputPreviewPath, Converter={StaticResource FilePathToImageSourceConverter}, ConverterParameter=1600}"
                                Background="{StaticResource TransparencyCheckerBrush}"
                                BitmapScalingMode="HighQuality"
                                PlaceholderForeground="#FF525966"
                                PlaceholderText="刷新预览后在此显示 Alpha 结果"
                                ViewportPadding="8" />
                        </Border>
                        <TextBlock Grid.Row="2"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontSize="9"
                                   Text="{Binding PreviewStatusText}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,8,0,0"
                    Style="{StaticResource BackgroundRemovalPreviewCardStyle}"
                    Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="批处理队列" />
                        <TextBlock Margin="12,0,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontSize="10"
                                   Text="{Binding BatchProgressText}" />
                    </DockPanel>
                    <DataGrid x:Name="BackgroundRemovalBatchDataGrid"
                              Grid.Row="1"
                              Margin="0,7,0,6"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              ItemsSource="{Binding BatchItems}"
                              SelectedItem="{Binding SelectedBatchItem, Mode=TwoWay}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Header="文件" Binding="{Binding FileName}" />
                            <DataGridTextColumn Width="100" Header="源尺寸" Binding="{Binding SourceSizeText}" />
                            <DataGridTextColumn Width="1.6*" Header="网格识别" Binding="{Binding CheckerDetectionText}" />
                            <DataGridTextColumn Width="72" Header="状态" Binding="{Binding StatusText}" />
                            <DataGridTextColumn Width="2*" Header="输出" Binding="{Binding OutputFileName}" />
                            <DataGridTextColumn Width="2*" Header="信息" Binding="{Binding Message}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2">
                        <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding BatchProgressPercent, Mode=OneWay}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="9"
                                   Text="{Binding BatchCurrentFileName, StringFormat=当前：{0}}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="10,6"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="BackgroundRemovalStatusText"
                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                       FontSize="10"
                       Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
