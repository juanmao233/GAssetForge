<UserControl x:Class="GAssetForge.App.Views.PixelAlignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GAssetForge.App.Controls"
             xmlns:conv="clr-namespace:GAssetForge.App.Converters"
             MinWidth="720"
             MinHeight="320"
             Background="{DynamicResource App.BackgroundBrush}">
    <UserControl.Resources>
        <conv:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource App.ButtonStyle}" />
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource App.TextBoxStyle}" />
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource App.ComboBoxStyle}" />
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource App.CheckBoxStyle}" />

        <Style x:Key="PixelAlignmentCardStyle"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource App.CardStyle}">
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="PixelAlignmentFieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="PixelAlignmentValueTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PixelAlignmentCompactButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource App.ButtonStyle}">
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="PixelAlignmentNumericTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource App.TextBoxStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <DrawingBrush x:Key="PixelAlignmentCheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF9DA2AA">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFC9CDD3">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="74" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,10"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Margin="14,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <CheckBox x:Name="PixelAlignmentBatchModeCheckBox"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Content="批量处理"
                              IsChecked="{Binding IsBatchMode, Mode=TwoWay}" />

                    <WrapPanel VerticalAlignment="Center">
                        <WrapPanel.Style>
                            <Style TargetType="{x:Type WrapPanel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <Button x:Name="ChoosePixelAlignmentInputButton"
                                MinWidth="96"
                                Margin="0,0,7,0"
                                Command="{Binding ChooseInputCommand}"
                                Content="导入图片…" />
                        <Button x:Name="ChoosePixelAlignmentOutputButton"
                                MinWidth="100"
                                Margin="0,0,7,0"
                                Command="{Binding ChooseOutputCommand}"
                                Content="设置输出…" />
                        <Button x:Name="ExportPixelAlignmentWorkingButton"
                                MinWidth="132"
                                Margin="0,0,7,0"
                                Command="{Binding ExportWorkingImageCommand}"
                                Content="导出最近邻工作图" />
                        <Button x:Name="ProcessPixelAlignmentButton"
                                MinWidth="112"
                                Command="{Binding ProcessCommand}"
                                Content="生成对齐图" />
                    </WrapPanel>

                    <WrapPanel VerticalAlignment="Center"
                               Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button x:Name="ChoosePixelAlignmentBatchInputsButton"
                                MinWidth="100"
                                Margin="0,0,7,0"
                                Command="{Binding ChooseBatchInputsCommand}"
                                Content="添加图片…" />
                        <Button x:Name="ChoosePixelAlignmentBatchOutputButton"
                                MinWidth="104"
                                Margin="0,0,7,0"
                                Command="{Binding ChooseBatchOutputDirectoryCommand}"
                                Content="输出目录…" />
                        <Button x:Name="ProcessPixelAlignmentBatchButton"
                                MinWidth="112"
                                Command="{Binding ProcessBatchCommand}"
                                Content="开始批处理" />
                    </WrapPanel>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="像素点对齐工具" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{DynamicResource App.TextSecondaryBrush}"
                               FontSize="10"
                               Text="整数倍最近邻放大 · 自定义行列采样 · 比例/旋转/四点透视矫正"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="326" MinWidth="240" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="286" MinWidth="210" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          Margin="0,0,8,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource PixelAlignmentCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="图片与输出" />

                            <TextBlock Margin="0,10,0,3"
                                       Style="{StaticResource PixelAlignmentFieldLabelStyle}"
                                       Text="输入图片" />
                            <TextBlock Style="{StaticResource PixelAlignmentValueTextStyle}"
                                       Text="{Binding InputFileName}"
                                       ToolTip="{Binding InputPath}" />
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="9"
                                       Text="{Binding SourceSizeText}" />

                            <TextBlock Margin="0,9,0,3"
                                       Style="{StaticResource PixelAlignmentFieldLabelStyle}"
                                       Text="对齐结果" />
                            <TextBlock Style="{StaticResource PixelAlignmentValueTextStyle}"
                                       Text="{Binding OutputFileName}"
                                       ToolTip="{Binding OutputPath}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource PixelAlignmentCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="放大与切分" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PixelAlignmentFieldLabelStyle}"
                                               Text="最低整数倍率" />
                                    <TextBox x:Name="PixelAlignmentMinimumScaleTextBox"
                                             Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                             Text="{Binding MinimumUpscaleFactor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Margin="0,18,0,0"
                                        Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                        Command="{Binding FitToApproximateSizeCommand}"
                                        Content="约 500px 自动"
                                        ToolTip="按当前裁切范围计算接近 500px 的最低整数放大倍率" />
                            </Grid>

                            <TextBlock Margin="0,10,0,4"
                                       Style="{StaticResource PixelAlignmentFieldLabelStyle}"
                                       Text="网格预设" />
                            <UniformGrid Columns="3">
                                <Button Margin="0,0,4,0"
                                        Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                        Command="{Binding SetGridPresetCommand}"
                                        CommandParameter="16"
                                        Content="16 × 16" />
                                <Button Margin="2,0"
                                        Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                        Command="{Binding SetGridPresetCommand}"
                                        CommandParameter="32"
                                        Content="32 × 32" />
                                <Button Margin="4,0,0,0"
                                        Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                        Command="{Binding SetGridPresetCommand}"
                                        CommandParameter="64"
                                        Content="64 × 64" />
                            </UniformGrid>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="列数 X（1–4096）" />
                                    <TextBox x:Name="PixelAlignmentColumnsTextBox"
                                             Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                             Text="{Binding Columns, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="行数 Y（1–4096）" />
                                    <TextBox x:Name="PixelAlignmentRowsTextBox"
                                             Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                             Text="{Binding Rows, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="9"
                                       Text="预设仅用于快速填写；可继续独立输入任意行列数，不会锁定为正方形。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="PixelAlignmentShowGridCheckBox"
                                      Margin="0,9,0,0"
                                      IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                                      Content="在源图裁切范围中显示采样网格" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource PixelAlignmentCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="颜色采样" />
                            <ComboBox x:Name="PixelAlignmentSamplingModeComboBox"
                                      Margin="0,9,0,0"
                                      ItemsSource="{Binding SamplingModeOptions}"
                                      SelectedItem="{Binding SelectedSamplingMode, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="9"
                                       Text="{Binding SamplingModeDescription}"
                                       TextWrapping="Wrap" />

                            <Separator Margin="0,10,0,8" />
                            <CheckBox x:Name="PixelAlignmentColorIndexCheckBox"
                                      IsChecked="{Binding EnableAutomaticColorIndex, Mode=TwoWay}"
                                      Content="自动颜色索引" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource PixelAlignmentFieldLabelStyle}"
                                           Text="最大颜色数（2–256）" />
                                <TextBox x:Name="PixelAlignmentMaximumColorsTextBox"
                                         Grid.Column="2"
                                         Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                         IsEnabled="{Binding EnableAutomaticColorIndex}"
                                         Text="{Binding MaximumIndexedColors, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="9"
                                       Text="{Binding ColorIndexDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="PixelAlignmentBatchQueueCard"
                            Margin="0,8,0,0"
                            Style="{StaticResource PixelAlignmentCardStyle}"
                            Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource App.AccentBrush}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Text="{Binding BatchTotalCount, StringFormat={}{0}/256}" />
                                <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="批处理队列" />
                            </DockPanel>

                            <TextBlock Margin="0,8,0,3"
                                       Style="{StaticResource PixelAlignmentFieldLabelStyle}"
                                       Text="输出目录" />
                            <TextBlock Style="{StaticResource PixelAlignmentValueTextStyle}"
                                       Text="{Binding BatchOutputDirectoryDisplay}"
                                       ToolTip="{Binding BatchOutputDirectory}" />

                            <ListBox x:Name="PixelAlignmentBatchItemsListBox"
                                     Height="196"
                                     Margin="0,9,0,0"
                                     ItemsSource="{Binding BatchItems}"
                                     SelectedItem="{Binding SelectedBatchItem, Mode=TwoWay}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                           FontSize="10"
                                                           Text="{Binding FileName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding InputPath}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                                           FontSize="9"
                                                           Text="{Binding SourceSizeText}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                           FontSize="9"
                                                           Text="{Binding Message}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Message}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource App.AccentBrush}"
                                                       FontSize="9"
                                                       Text="{Binding StatusText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ProgressBar x:Name="PixelAlignmentBatchProgressBar"
                                         Height="8"
                                         Margin="0,9,0,0"
                                         Maximum="100"
                                         Value="{Binding BatchProgressPercent, Mode=OneWay}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                                       FontSize="9"
                                       Text="{Binding BatchProgressText}"
                                       TextWrapping="Wrap" />
                            <UniformGrid Margin="0,8,0,0" Columns="2">
                                <Button x:Name="RemovePixelAlignmentBatchItemButton"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                        Command="{Binding RemoveSelectedBatchItemCommand}"
                                        Content="移除选中" />
                                <Button x:Name="ClearPixelAlignmentBatchItemsButton"
                                        Margin="4,0,0,0"
                                        Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                        Command="{Binding ClearBatchItemsCommand}"
                                        Content="清空队列" />
                            </UniformGrid>
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="9"
                                       Text="第一张图片作为预览与标尺基准；其它尺寸会按宽高比例映射裁切和透视点。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource PixelAlignmentCardStyle}">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                        Command="{Binding ResetCropCommand}"
                                        Content="恢复全图" />
                                <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="裁切标尺（源像素）" />
                            </DockPanel>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="左 / Left" />
                                    <TextBox x:Name="PixelAlignmentCropLeftTextBox"
                                             Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                             Text="{Binding CropLeft, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="右 / Right（排他）" />
                                    <TextBox x:Name="PixelAlignmentCropRightTextBox"
                                             Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                             Text="{Binding CropRight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="上 / Top" />
                                    <TextBox x:Name="PixelAlignmentCropTopTextBox"
                                             Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                             Text="{Binding CropTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="下 / Bottom（排他）" />
                                    <TextBox x:Name="PixelAlignmentCropBottomTextBox"
                                             Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                             Text="{Binding CropBottom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{DynamicResource App.AccentBrush}"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       FontSize="10"
                                       Text="{Binding CropSizeText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource PixelAlignmentCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="矫正对齐" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="9"
                                       Text="三项可独立启用，并按四点透视 → 比例重整 → 顺时针旋转的管线处理。"
                                       TextWrapping="Wrap" />

                            <Border Margin="0,10,0,0"
                                    Padding="9"
                                    Background="{DynamicResource App.InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <CheckBox x:Name="PixelAlignmentEnableAspectCorrectionCheckBox"
                                              IsChecked="{Binding EnableAspectRatioCorrection, Mode=TwoWay}"
                                              Content="1. 比例重整" />
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                               FontSize="9"
                                               Text="将裁切/透视后的画面重整为目标 A:B；不会自动覆盖最终网格行列。"
                                               TextWrapping="Wrap" />
                                    <UniformGrid Margin="0,7,0,0" Columns="3">
                                        <Button Margin="0,0,3,0"
                                                Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                                Command="{Binding SetAspectRatioPresetCommand}"
                                                CommandParameter="1:1"
                                                Content="1 : 1" />
                                        <Button Margin="2,0"
                                                Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                                Command="{Binding SetAspectRatioPresetCommand}"
                                                CommandParameter="2:1"
                                                Content="2 : 1" />
                                        <Button Margin="3,0,0,0"
                                                Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                                Command="{Binding SetAspectRatioPresetCommand}"
                                                CommandParameter="1:2"
                                                Content="1 : 2" />
                                    </UniformGrid>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="目标 A（宽）" />
                                            <TextBox x:Name="PixelAlignmentTargetAspectATextBox"
                                                     Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                                     Text="{Binding TargetAspectRatioA, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="0,17,0,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                                   Text=":" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="目标 B（高）" />
                                            <TextBox x:Name="PixelAlignmentTargetAspectBTextBox"
                                                     Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                                     Text="{Binding TargetAspectRatioB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                    </Grid>
                                    <Button x:Name="PixelAlignmentSyncGridAspectButton"
                                            Margin="0,7,0,0"
                                            Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                            Command="{Binding SyncGridToAspectRatioCommand}"
                                            Content="按目标比例同步网格（显式）" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="9"
                                               Text="{Binding AspectGridStatusText}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAspectGridMismatch}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFB454" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,7,0,0"
                                    Padding="9"
                                    Background="{DynamicResource App.InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <CheckBox x:Name="PixelAlignmentEnableRotationCorrectionCheckBox"
                                              IsChecked="{Binding EnableRotationCorrection, Mode=TwoWay}"
                                              Content="2. 角度调整（正值为顺时针）" />
                                    <UniformGrid Margin="0,7,0,0" Columns="3">
                                        <Button Margin="0,0,3,0"
                                                Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                                Command="{Binding SetRotationPresetCommand}"
                                                CommandParameter="-90"
                                                Content="-90°" />
                                        <Button Margin="2,0"
                                                Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                                Command="{Binding SetRotationPresetCommand}"
                                                CommandParameter="0"
                                                Content="0°" />
                                        <Button Margin="3,0,0,0"
                                                Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                                Command="{Binding SetRotationPresetCommand}"
                                                CommandParameter="90"
                                                Content="90°" />
                                    </UniformGrid>
                                    <TextBlock Margin="0,7,0,4"
                                               Style="{StaticResource PixelAlignmentFieldLabelStyle}"
                                               Text="自定义角度（-180°–180°）" />
                                    <TextBox x:Name="PixelAlignmentRotationDegreesTextBox"
                                             Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                             Text="{Binding RotationDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,7,0,0"
                                    Padding="9"
                                    Background="{DynamicResource App.InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                                Command="{Binding ResetPerspectivePointsCommand}"
                                                Content="从裁切重置四点" />
                                        <CheckBox x:Name="PixelAlignmentEnablePerspectiveCorrectionCheckBox"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding EnablePerspectiveCorrection, Mode=TwoWay}"
                                                  Content="3. 夹角透视矫正" />
                                    </DockPanel>
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                               FontSize="9"
                                               Text="启用后可直接拖动预览中的橙色 TL/TR/BR/BL 顶点，坐标按源像素整数吸附。"
                                               TextWrapping="Wrap" />

                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="5" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="5" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="5" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="TL" />
                                        <TextBox Grid.Column="1" Style="{StaticResource PixelAlignmentNumericTextBoxStyle}" Text="{Binding PerspectiveTopLeftX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="TL X" />
                                        <TextBox Grid.Column="3" Style="{StaticResource PixelAlignmentNumericTextBoxStyle}" Text="{Binding PerspectiveTopLeftY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="TL Y" />

                                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="TR" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource PixelAlignmentNumericTextBoxStyle}" Text="{Binding PerspectiveTopRightX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="TR X" />
                                        <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource PixelAlignmentNumericTextBoxStyle}" Text="{Binding PerspectiveTopRightY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="TR Y" />

                                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="BR" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource PixelAlignmentNumericTextBoxStyle}" Text="{Binding PerspectiveBottomRightX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="BR X" />
                                        <TextBox Grid.Row="4" Grid.Column="3" Style="{StaticResource PixelAlignmentNumericTextBoxStyle}" Text="{Binding PerspectiveBottomRightY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="BR Y" />

                                        <TextBlock Grid.Row="6" VerticalAlignment="Center" Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="BL" />
                                        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource PixelAlignmentNumericTextBoxStyle}" Text="{Binding PerspectiveBottomLeftX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="BL X" />
                                        <TextBox Grid.Row="6" Grid.Column="3" Style="{StaticResource PixelAlignmentNumericTextBoxStyle}" Text="{Binding PerspectiveBottomLeftY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="BL Y" />
                                    </Grid>

                                    <TextBlock Margin="0,8,0,4"
                                               Style="{StaticResource PixelAlignmentFieldLabelStyle}"
                                               Text="目标 A/B 边夹角（5°–175°）" />
                                    <TextBox x:Name="PixelAlignmentTargetEdgeAngleTextBox"
                                             Style="{StaticResource PixelAlignmentNumericTextBoxStyle}"
                                             Text="{Binding TargetEdgeAngleDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{DynamicResource App.AccentBrush}"
                                       FontSize="9"
                                       Text="{Binding CorrectionStepsText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource PixelAlignmentCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="兼容尺寸计划" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="矫正基础尺寸" />
                                <TextBlock Grid.Column="1" Style="{StaticResource PixelAlignmentValueTextStyle}" Text="{Binding CorrectedBaseSizeText}" />
                                <TextBlock Grid.Row="1" Margin="0,5,0,4" Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="请求工作尺寸" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" Style="{StaticResource PixelAlignmentValueTextStyle}" Text="{Binding RequestedWorkingSizeText}" />
                                <TextBlock Grid.Row="2" Margin="0,5,0,4" Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="矫正工作尺寸" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" Style="{StaticResource PixelAlignmentValueTextStyle}" Text="{Binding CorrectedWorkingSizeText}" />
                                <TextBlock Grid.Row="3" Margin="0,5,0,4" Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="兼容倍率" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,5,0,0" Style="{StaticResource PixelAlignmentValueTextStyle}" Text="{Binding WorkingScaleText}" />
                                <TextBlock Grid.Row="4" Margin="0,5,0,4" Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="每格工作尺寸" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,5,0,0" Style="{StaticResource PixelAlignmentValueTextStyle}" Text="{Binding CellSizeText}" />
                                <TextBlock Grid.Row="5" Margin="0,5,0,0" Style="{StaticResource PixelAlignmentFieldLabelStyle}" Text="最终输出" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,5,0,0" Style="{StaticResource PixelAlignmentValueTextStyle}" Text="{Binding OutputSizeText}" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="9"
                                       Text="{Binding PlanExplanation}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="9"
                                       Text="{Binding GeometryFitStatusText}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGeometryFitPaddingRequired}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFB454" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Margin="8,0"
                    Style="{StaticResource PixelAlignmentCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource App.AccentBrush}"
                                   FontFamily="Consolas, Microsoft YaHei UI"
                                   FontSize="10"
                                   Text="{Binding CropSizeText}" />
                        <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="源图与裁切标尺" />
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,10,0,8"
                            Background="{DynamicResource App.InputBackgroundBrush}"
                            BorderBrush="{DynamicResource App.BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            ClipToBounds="True">
                        <controls:PixelAlignmentSurface x:Name="PixelAlignmentSurface"
                                                        SourcePath="{Binding InputPath}"
                                                        CropLeft="{Binding CropLeft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        CropTop="{Binding CropTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        CropRight="{Binding CropRight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        CropBottom="{Binding CropBottom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Columns="{Binding Columns}"
                                                        Rows="{Binding Rows}"
                                                        ShowGrid="{Binding ShowGrid}"
                                                        PerspectiveCorrectionEnabled="{Binding EnablePerspectiveCorrection}"
                                                        PerspectiveTopLeftX="{Binding PerspectiveTopLeftX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        PerspectiveTopLeftY="{Binding PerspectiveTopLeftY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        PerspectiveTopRightX="{Binding PerspectiveTopRightX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        PerspectiveTopRightY="{Binding PerspectiveTopRightY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        PerspectiveBottomRightX="{Binding PerspectiveBottomRightX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        PerspectiveBottomRightY="{Binding PerspectiveBottomRightY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        PerspectiveBottomLeftX="{Binding PerspectiveBottomLeftX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        PerspectiveBottomLeftY="{Binding PerspectiveBottomLeftY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <DockPanel Grid.Row="2" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="9"
                                   Text="右键/双击：复位视图" />
                        <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="9"
                                   Text="拖动青色四边线裁切 · 橙色四点矫正透视 · 滚轮缩放 · 中键平移"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Grid Grid.Column="4" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PixelAlignmentCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="10,0,0,0"
                                       Foreground="{DynamicResource App.AccentBrush}"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       Text="{Binding PreviewSizeText}" />
                            <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="{Binding PreviewTitle}" />
                        </DockPanel>

                        <Border Grid.Row="1"
                                Margin="0,10,0,8"
                                Background="{StaticResource PixelAlignmentCheckerBrush}"
                                BorderBrush="{DynamicResource App.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                ClipToBounds="True">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOutputPreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="#FF555C68"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="30"
                                               Text="&#xEB9F;" />
                                    <TextBlock Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="#FF555C68"
                                               FontSize="10"
                                               Text="生成后在此显示像素采样结果" />
                                </StackPanel>
                                <Image x:Name="PixelAlignmentOutputPreview"
                                       Margin="10"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       SnapsToDevicePixels="True"
                                       Source="{Binding OutputPreviewPath, Converter={StaticResource FilePathToImageSourceConverter}, ConverterParameter=1200}"
                                       Stretch="Uniform" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontSize="9"
                                   Text="{Binding ResultSummary}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PixelAlignmentCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource App.PanelHeaderStyle}" Text="当前预览文件" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontFamily="Consolas, Microsoft YaHei UI"
                                   FontSize="9"
                                   Text="{Binding OutputPreviewPath}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding OutputPreviewPath}" />
                        <Button x:Name="OpenPixelAlignmentOutputButton"
                                Margin="0,9,0,0"
                                Style="{StaticResource PixelAlignmentCompactButtonStyle}"
                                Command="{Binding OpenOutputDirectoryCommand}"
                                Content="打开输出目录" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Margin="10,0,10,8"
                Padding="11,8"
                Background="{DynamicResource App.InputBackgroundBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{DynamicResource App.AccentBrush}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           Text="&#xE9D9;"
                           ToolTip="最新处理记录" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Text="最新处理记录（详细信息同步到指令日志）" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontFamily="Consolas, Microsoft YaHei UI"
                               FontSize="10"
                               Text="{Binding ResultSummary}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ResultSummary}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Padding="10,0"
                Background="{DynamicResource App.SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,7,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.AccentBrush}"
                           FontSize="8"
                           Text="●" />
                <TextBlock x:Name="PixelAlignmentStatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="10"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}" />
            </DockPanel>
        </Border>

        <Border Grid.RowSpan="4"
                Panel.ZIndex="20"
                Background="{DynamicResource App.OverlayBrush}"
                IsHitTestVisible="True">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="320"
                    Padding="18,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource App.SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource App.AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.AccentBrush}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Text="&#xE895;" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Text="正在处理像素对齐任务…" />
                    </StackPanel>
                    <ProgressBar Height="8"
                                 Margin="0,12,0,0"
                                 Maximum="100"
                                 Value="{Binding BatchProgressPercent, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="{x:Type ProgressBar}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource App.TextSecondaryBrush}"
                               FontSize="9"
                               Text="{Binding BatchProgressText}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
