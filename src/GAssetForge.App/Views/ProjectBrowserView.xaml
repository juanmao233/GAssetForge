<UserControl x:Class="GAssetForge.App.Views.ProjectBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280"
             MinHeight="150">
    <UserControl.Resources>
        <Style x:Key="ProjectTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Padding="13,8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background"
                                        Value="{DynamicResource App.SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
                                <Setter TargetName="TabChrome" Property="Background"
                                        Value="{DynamicResource App.SurfaceRaisedBrush}" />
                                <Setter TargetName="TabChrome" Property="BorderBrush"
                                        Value="{DynamicResource App.AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource App.ToolbarButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="ProjectContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <Style x:Key="ProjectContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="9,6" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AssetListItemStyle" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="Margin" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AssetColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="10" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.SurfaceBrush}">
        <TabControl SelectedIndex="0"
                    Background="{DynamicResource App.SurfaceBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
            <TabItem Header="Assets" Style="{StaticResource ProjectTabItemStyle}">
                <Grid Background="{DynamicResource App.SurfaceBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <Border Padding="8,6"
                            Background="{DynamicResource App.SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left"
                                       Margin="3,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       Text="{Binding RootDisplayName}"
                                       TextTrimming="CharacterEllipsis" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ChooseAssetRootButton"
                                            Content="选择目录…"
                                            ToolTip="选择 Assets 根目录"
                                            Command="{Binding ChooseRootCommand}"
                                            Style="{StaticResource ProjectToolbarButtonStyle}" />
                                    <Button x:Name="UseDefaultAssetRootButton"
                                            Content="默认"
                                            ToolTip="切换到默认 Assets 目录"
                                            Command="{Binding UseDefaultRootCommand}"
                                            Style="{StaticResource ProjectToolbarButtonStyle}" />
                                    <Button x:Name="NavigateUpButton"
                                            Content="上一级"
                                            ToolTip="返回上一级目录"
                                            Command="{Binding NavigateUpCommand}"
                                            Style="{StaticResource ProjectToolbarButtonStyle}" />
                                    <Button x:Name="RefreshAssetsButton"
                                            Content="刷新"
                                            ToolTip="刷新当前目录"
                                            Command="{Binding RefreshCommand}"
                                            Style="{StaticResource ProjectToolbarButtonStyle}" />
                                    <Button x:Name="CreateAssetFolderButton"
                                            Content="新建文件夹"
                                            ToolTip="在当前目录创建文件夹"
                                            Command="{Binding CreateFolderCommand}"
                                            Style="{StaticResource ProjectToolbarButtonStyle}" />
                                    <Button x:Name="OpenAssetFolderButton"
                                            Content="资源管理器"
                                            ToolTip="在 Windows 资源管理器中打开当前目录"
                                            Command="{Binding OpenCurrentFolderCommand}"
                                            Style="{StaticResource ProjectToolbarButtonStyle}" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Padding="8,3"
                            Background="{DynamicResource App.SurfaceBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Tag="{Binding FullPath}"
                                                    Content="{Binding Label}"
                                                    Click="Breadcrumb_OnClick"
                                                    Style="{StaticResource ProjectToolbarButtonStyle}" />
                                            <TextBlock Margin="1,0,5,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                                       Text="›" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" MinWidth="110" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource App.SurfaceBrush}"
                                BorderBrush="{DynamicResource App.BorderBrush}"
                                BorderThickness="0,0,1,0">
                            <TreeView x:Name="AssetFolderTree"
                                      Padding="5"
                                      ItemsSource="{Binding FolderRoots}"
                                      Background="{DynamicResource App.SurfaceBrush}"
                                      Foreground="{DynamicResource App.TextPrimaryBrush}"
                                      BorderThickness="0"
                                      SelectedItemChanged="AssetFolderTree_OnSelectedItemChanged"
                                      TreeViewItem.Expanded="AssetFolderTreeItem_OnExpanded">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource App.AccentBrush}"
                                                       Text="&#xE8B7;" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.Resources>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
                                        <Setter Property="Padding" Value="3,2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </TreeView.Resources>
                            </TreeView>
                        </Border>

                        <GridSplitter Grid.Column="1"
                                      Width="5"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="{DynamicResource App.BorderBrush}"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Columns"
                                      ShowsPreview="True" />

                        <ListView x:Name="AssetEntryList"
                                  Grid.Column="2"
                                  ItemsSource="{Binding Entries}"
                                  Background="{DynamicResource App.SurfaceBrush}"
                                  Foreground="{DynamicResource App.TextPrimaryBrush}"
                                  BorderThickness="0"
                                  ItemContainerStyle="{StaticResource AssetListItemStyle}"
                                  ContextMenuOpening="AssetEntryList_OnContextMenuOpening"
                                  MouseDoubleClick="AssetEntryList_OnMouseDoubleClick">
                            <ListView.ContextMenu>
                                <ContextMenu x:Name="AssetBlankContextMenu"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Style="{StaticResource ProjectContextMenuStyle}">
                                    <MenuItem x:Name="RefreshAssetContextMenuItem"
                                              Header="刷新"
                                              InputGestureText="F5"
                                              Command="{Binding RefreshCommand}"
                                              Style="{StaticResource ProjectContextMenuItemStyle}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="OpenAssetFolderContextMenuItem"
                                              Header="打开当前文件夹所在位置"
                                              Command="{Binding OpenCurrentFolderCommand}"
                                              Style="{StaticResource ProjectContextMenuItemStyle}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem x:Name="TestCreateAssetContextMenuItem"
                                              Header="创建（测试）"
                                              ToolTip="测试占位功能，不会创建任何文件"
                                              Command="{Binding TestCreateCommand}"
                                              Style="{StaticResource ProjectContextMenuItemStyle}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource AssetColumnHeaderStyle}">
                                    <GridViewColumn Width="220" Header="名称">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="22"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{DynamicResource App.AccentBrush}"
                                                               Text="{Binding IconGlyph}" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="100"
                                                    Header="类型"
                                                    DisplayMemberBinding="{Binding KindLabel}" />
                                    <GridViewColumn Width="92"
                                                    Header="大小"
                                                    DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Width="132"
                                                    Header="修改时间"
                                                    DisplayMemberBinding="{Binding ModifiedText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock Grid.Column="2"
                                   Margin="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   IsHitTestVisible="False"
                                   Text="当前目录为空">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="3"
                            Padding="8,0"
                            Background="{DynamicResource App.SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DockPanel LastChildFill="True" ToolTip="{Binding CurrentPath}">
                                <TextBlock DockPanel.Dock="Left"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.AccentBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="● 输出" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                                           FontSize="10"
                                           Text="{Binding CurrentPath}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="{Binding EntryCountText}" />
                            <TextBlock Grid.Column="2"
                                       Margin="12,0,0,0"
                                       MaxWidth="220"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="{Binding StatusText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding StatusText}" />
                            <Button Grid.Column="3"
                                    Margin="8,0,0,0"
                                    MinWidth="44"
                                    Height="22"
                                    Padding="6,1"
                                    Content="复制路径"
                                    Command="{Binding CopyCurrentPathCommand}"
                                    Style="{StaticResource ProjectToolbarButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="内置 Prefabs"
                     IsEnabled="{Binding IsPrefabLibraryAvailable}"
                     ToolTip="仅页面 UI 设计工作流可实例化内置 Prefab"
                     Style="{StaticResource ProjectTabItemStyle}">
                <Grid DataContext="{Binding EditorWorkspace}"
                      Background="{DynamicResource App.SurfaceBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="12,9"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="内置 Prefabs"
                                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="10,0,0,0"
                                           Text="Library /"
                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="4,0,0,0"
                                           Text="{Binding ActiveFolderName}"
                                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding PrefabCountText}"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="0,0,1,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="5,7">
                                    <TextBlock Margin="8,2,8,6"
                                               Text="FOLDERS"
                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                               FontSize="9"
                                               FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding ProjectFolders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,1"
                                                        Padding="8,6"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding SelectCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource App.ButtonStyle}">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource App.SelectionBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE8B7;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{DynamicResource App.AccentBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding AssetCount}"
                                                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                                                   FontSize="9"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <ScrollViewer Grid.Column="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Prefabs}" Margin="10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="148" Height="116" Margin="0,0,8,8" Padding="10"
                                                Background="{DynamicResource App.SurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource App.BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Cursor="Hand"
                                                ToolTip="拖到画布实例化；双击在默认位置创建"
                                                PreviewMouseLeftButtonDown="Prefab_OnPreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Prefab_OnPreviewMouseMove"
                                                PreviewMouseLeftButtonUp="Prefab_OnPreviewMouseLeftButtonUp">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="52" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Background="{DynamicResource App.InputBackgroundBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                               FontSize="23"
                                                               Foreground="{DynamicResource App.AccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE7B8;" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ComponentType}" Value="button">
                                                                        <Setter Property="Text" Value="&#xE8F4;" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ComponentType}" Value="input">
                                                                        <Setter Property="Text" Value="&#xE8D2;" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ComponentType}" Value="panel">
                                                                        <Setter Property="Text" Value="&#xE80F;" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ComponentType}" Value="slider">
                                                                        <Setter Property="Text" Value="&#xE9E9;" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ComponentType}" Value="toggle">
                                                                        <Setter Property="Text" Value="&#xE73A;" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Text="{Binding SizeLabel}"
                                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                                               FontSize="9" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Column="1"
                                   Text="此文件夹中暂无 Prefab"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Prefabs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
