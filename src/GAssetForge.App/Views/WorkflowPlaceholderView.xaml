<UserControl x:Class="GAssetForge.App.Views.WorkflowPlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GAssetForge.App.Converters">
    <UserControl.Resources>
        <conv:StringToBrushConverter x:Key="StringToBrushConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.BackgroundBrush}">
        <Border Width="620"
                MaxWidth="620"
                Padding="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource App.SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="56" Height="6"
                        Background="{Binding Workflow.Accent, Converter={StaticResource StringToBrushConverter}, ConverterParameter=#65ADF2}"
                        CornerRadius="3"
                        HorizontalAlignment="Left" />
                <StackPanel Grid.Row="1" Margin="0,26,0,0">
                    <TextBlock Text="{Binding Workflow.Category}"
                               Foreground="{Binding Workflow.Accent, Converter={StaticResource StringToBrushConverter}, ConverterParameter=#65ADF2}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0"
                               Text="{Binding Workflow.Label}"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontSize="30"
                               FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock Grid.Row="2" Margin="0,22,0,0"
                           Text="{Binding Workflow.Description}"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="15"
                           LineHeight="25"
                           TextWrapping="Wrap" />

                <Border Grid.Row="3" Margin="0,26,0,0" Padding="18"
                        Background="{DynamicResource App.InputBackgroundBrush}"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding StateLabel}"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,0"
                                   Text="{Binding NextStep}"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="12"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
