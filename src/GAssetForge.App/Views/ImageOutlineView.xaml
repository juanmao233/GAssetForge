<UserControl x:Class="GAssetForge.App.Views.ImageOutlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GAssetForge.App.Converters"
             MinWidth="620"
             MinHeight="430"
             Background="{DynamicResource App.BackgroundBrush}">
    <UserControl.Resources>
        <conv:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />
        <conv:StringToBrushConverter x:Key="StringToBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DrawingBrush x:Key="ImageOutlineCheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,20,20"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFB9BDC4">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,20,20" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFE1E3E7">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,10,10" />
                                <RectangleGeometry Rect="10,10,10,10" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="ImageOutlineCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="ImageOutlineCompactButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16,12"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="图片描边工具" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource App.TextSecondaryBrush}"
                               Text="基于图片 Alpha 快速创建向外、向内或中心描边，并支持多图批量处理。"
                               TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button x:Name="ChooseImageOutlineInputButton"
                            MinWidth="104"
                            Margin="0,0,7,7"
                            Command="{Binding ChooseInputCommand}"
                            Content="选择图片…"
                            Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="ChooseImageOutlineOutputButton"
                            MinWidth="108"
                            Margin="0,0,7,7"
                            Command="{Binding ChooseOutputCommand}"
                            Content="设置输出…"
                            Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="ProcessImageOutlineButton"
                            MinWidth="112"
                            Margin="0,0,0,7"
                            Command="{Binding RefreshPreviewCommand}"
                            Content="刷新描边预览"
                            Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="ChooseImageOutlineBatchInputsButton"
                            MinWidth="112"
                            Margin="0,0,7,7"
                            Command="{Binding ChooseBatchInputsCommand}"
                            Content="添加多张图片…"
                            Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="ChooseImageOutlineBatchOutputButton"
                            MinWidth="112"
                            Margin="0,0,7,7"
                            Command="{Binding ChooseBatchOutputDirectoryCommand}"
                            Content="批量输出目录…"
                            Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="ProcessImageOutlineBatchButton"
                            MinWidth="112"
                            Margin="0,0,0,7"
                            Command="{Binding ProcessBatchCommand}"
                            Content="执行批量描边"
                            Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border>
                        <Border.Style>
                            <Style TargetType="{x:Type Border}"
                                   BasedOn="{StaticResource ImageOutlineCardStyle}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBatchMode}" Value="True" />
                                            <Condition Binding="{Binding IsBusy}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsEnabled" Value="False" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="处理模式" />
                            <CheckBox x:Name="ImageOutlineBatchModeCheckBox"
                                      Margin="0,11,0,0"
                                      IsChecked="{Binding IsBatchMode, Mode=TwoWay}"
                                      Content="批量处理模式" />
                            <TextBlock Margin="0,12,0,5"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                                       Text="描边种类" />
                            <ComboBox x:Name="ImageOutlineModeComboBox"
                                      ItemsSource="{Binding ModeOptions}"
                                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="{Binding ModeDescription}"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,14,0,4"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                                       Text="描边宽度" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Width="50"
                                           TextAlignment="Right"
                                           Text="{Binding OutlineWidth, StringFormat={}{0} px}" />
                                <Slider x:Name="ImageOutlineWidthSlider"
                                        Minimum="1"
                                        Maximum="128"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding OutlineWidth, Mode=TwoWay}" />
                            </DockPanel>

                            <TextBlock Margin="0,13,0,5"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                                       Text="描边颜色（#RRGGBB）" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ImageOutlineColorPickerButton"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        Background="{Binding EffectiveColorHex, Converter={StaticResource StringToBrushConverter}}"
                                        BorderBrush="{DynamicResource App.BorderStrongBrush}"
                                        BorderThickness="1"
                                        Command="{Binding ChooseOutlineColorCommand}"
                                        ToolTip="打开 HSV / RGB 取色器" />
                                <TextBox x:Name="ImageOutlineColorTextBox"
                                         Grid.Column="2"
                                         VerticalContentAlignment="Center"
                                         FontFamily="Consolas"
                                         Text="{Binding OutlineColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <TextBlock Margin="0,13,0,4"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                                       Text="主体 Alpha 阈值" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Width="40"
                                           TextAlignment="Right"
                                           Text="{Binding AlphaThreshold}" />
                                <Slider x:Name="ImageOutlineAlphaThresholdSlider"
                                        Minimum="1"
                                        Maximum="254"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding AlphaThreshold, Mode=TwoWay}" />
                            </DockPanel>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="低于此 Alpha 的像素不会被视为主体，可用于忽略极弱透明噪点。"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="ImageOutlineExpandCanvasCheckBox"
                                      Margin="0,12,0,0"
                                      IsChecked="{Binding ExpandCanvas, Mode=TwoWay}"
                                      Content="扩展画布以完整保留外侧描边" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="{Binding CanvasBehaviorText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="{Binding ConfigurationValidationText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0" Style="{StaticResource ImageOutlineCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="文件与输出" />
                            <StackPanel Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,10,0,3"
                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                           FontSize="10"
                                           Text="输入" />
                                <TextBlock Text="{Binding InputFileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputPath}" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                           FontSize="10"
                                           Text="{Binding InputSizeText}" />
                                <TextBlock Margin="0,9,0,3"
                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                           FontSize="10"
                                           Text="输出" />
                                <TextBlock Text="{Binding OutputFileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,10,0,3"
                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                           FontSize="10"
                                           Text="批量输出目录" />
                                <TextBlock Text="{Binding BatchOutputDirectory, TargetNullValue=尚未选择}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding BatchOutputDirectory}" />
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <Button Style="{StaticResource ImageOutlineCompactButtonStyle}"
                                            Command="{Binding RemoveSelectedBatchItemCommand}"
                                            Content="移除所选" />
                                    <Button Margin="7,0,0,0"
                                            Style="{StaticResource ImageOutlineCompactButtonStyle}"
                                            Command="{Binding ClearBatchItemsCommand}"
                                            Content="清空队列" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="OpenImageOutlineOutputButton"
                                    Margin="0,11,0,0"
                                    Command="{Binding OpenOutputDirectoryCommand}"
                                    Content="打开最新输出目录" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ImageOutlineCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="原图" />
                            <Border Grid.Row="1"
                                    Margin="0,10,0,8"
                                    Background="{StaticResource ImageOutlineCheckerBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#FF525966"
                                               Text="选择图片后在此预览" />
                                    <Image x:Name="ImageOutlineInputPreview"
                                           Margin="8"
                                           Source="{Binding InputPath, Converter={StaticResource FilePathToImageSourceConverter}, ConverterParameter=1000}"
                                           Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="2"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="{Binding InputPath}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource ImageOutlineCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Margin="0,0,10,6"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="描边结果" />
                                <Button x:Name="RefreshImageOutlineResultPreviewButton"
                                        MinWidth="88"
                                        Margin="0,0,7,6"
                                        Style="{StaticResource ImageOutlineCompactButtonStyle}"
                                        Command="{Binding RefreshPreviewCommand}"
                                        Content="刷新预览" />
                                <Button x:Name="SaveImageOutlineResultButton"
                                        MinWidth="88"
                                        Margin="0,0,0,6"
                                        Style="{StaticResource ImageOutlineCompactButtonStyle}"
                                        Command="{Binding SaveResultCommand}"
                                        Content="保存结果" />
                            </WrapPanel>
                            <Border Grid.Row="1"
                                    Margin="0,10,0,8"
                                    Background="{StaticResource ImageOutlineCheckerBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#FF525966"
                                               Text="处理完成后在此预览">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOutputPreview}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image x:Name="ImageOutlineOutputPreview"
                                           Margin="8"
                                           Source="{Binding OutputPreviewPath, Converter={StaticResource FilePathToImageSourceConverter}, ConverterParameter=1000}"
                                           Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="2">
                                <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}"
                                           FontSize="10"
                                           Text="{Binding PreviewStatusText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{DynamicResource App.TextMutedBrush}"
                                           FontSize="10"
                                           Text="{Binding ResultSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Style="{StaticResource ImageOutlineCardStyle}"
                        Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="批处理队列" />
                            <TextBlock Margin="12,0,0,0"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                                       Text="{Binding BatchProgressText}" />
                        </DockPanel>
                        <DataGrid x:Name="ImageOutlineBatchDataGrid"
                                  Grid.Row="1"
                                  Margin="0,9,0,8"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding BatchItems}"
                                  SelectedItem="{Binding SelectedBatchItem, Mode=TwoWay}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="2*" Header="文件" Binding="{Binding FileName}" />
                                <DataGridTextColumn Width="110" Header="源尺寸" Binding="{Binding SourceSizeText}" />
                                <DataGridTextColumn Width="72" Header="状态" Binding="{Binding StatusText}" />
                                <DataGridTextColumn Width="2*" Header="输出" Binding="{Binding OutputFileName}" />
                                <DataGridTextColumn Width="2*" Header="信息" Binding="{Binding Message}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2">
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding BatchProgress, Mode=OneWay}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="{Binding BatchCurrentFileName, StringFormat=当前：{0}}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="12,7"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="ImageOutlineStatusText"
                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                       Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
