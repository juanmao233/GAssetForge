<UserControl x:Class="GAssetForge.App.Views.IconDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:GAssetForge.App.Controls"
             MinWidth="760"
             MinHeight="500"
             Background="{DynamicResource App.BackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="IconParameterPanelStyle" TargetType="Border">
            <Setter Property="Width" Value="182" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="IconParameterLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="IconNumericTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource App.TextBoxStyle}">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconPreviewHeaderStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="IconModeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource App.InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource App.ComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="IconModeComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <TextBlock Margin="9,0,30,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Path Width="8"
                                          Height="5"
                                          Margin="0,0,10,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{DynamicResource App.TextSecondaryBrush}"
                                          Stretch="Fill" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,2,0,0"
                                        Padding="1"
                                        Background="{DynamicResource App.InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource App.BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="IconModeComboChrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource App.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="IconModeComboChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,10"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               Text="Icon 图标制作" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource App.TextSecondaryBrush}"
                               Text="用可复现的相机参数描述图标主体角度，并同步检查空间布置与最终镜头画面。"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{DynamicResource App.TextMutedBrush}"
                               FontSize="10"
                               Text="制作模式" />
                    <ComboBox x:Name="IconDesignModeComboBox"
                              Width="172"
                              Style="{StaticResource IconModeComboBoxStyle}"
                              ItemsSource="{Binding ModeOptions}"
                              SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              automation:AutomationProperties.Name="Icon 制作模式" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="10"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,8">
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Margin="6,0,0,0"
                                Padding="10,4"
                                Style="{StaticResource App.ToolbarButtonStyle}"
                                Command="{Binding ApplyFrontPresetCommand}"
                                Content="正面" />
                        <Button Margin="6,0,0,0"
                                Padding="10,4"
                                Style="{StaticResource App.ToolbarButtonStyle}"
                                Command="{Binding ApplyThreeQuarterPresetCommand}"
                                Content="3/4 视角" />
                        <Button Margin="6,0,0,0"
                                Padding="10,4"
                                Style="{StaticResource App.ToolbarButtonStyle}"
                                Command="{Binding ApplyTopThreeQuarterPresetCommand}"
                                Content="高位 3/4" />
                        <Button Margin="6,0,0,0"
                                Padding="10,4"
                                Style="{StaticResource App.ToolbarButtonStyle}"
                                Command="{Binding ResetCommand}"
                                Content="重置" />
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   Text="相机与画幅参数" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="10"
                                   Text="正值方位角向 +X 环绕；正值仰角从上方俯视；正值滚转使最终画面顺时针旋转。" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconParameterPanelStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IconParameterLabelStyle}"
                                           Text="美术图尺寸" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="IconImageWidthTextBox"
                                             Width="65"
                                             Style="{StaticResource IconNumericTextBoxStyle}"
                                             Text="{Binding ImageWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Icon 图片宽度" />
                                    <TextBlock Margin="7,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                               Text="×" />
                                    <TextBox x:Name="IconImageHeightTextBox"
                                             Width="65"
                                             Style="{StaticResource IconNumericTextBoxStyle}"
                                             Text="{Binding ImageHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Icon 图片高度" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource IconParameterPanelStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                                               Text="{Binding CameraAzimuthDegrees, StringFormat={}{0:0.#}°}" />
                                    <TextBlock Style="{StaticResource IconParameterLabelStyle}"
                                               Margin="0"
                                               Text="相机方位角" />
                                </DockPanel>
                                <Slider x:Name="IconCameraAzimuthSlider"
                                        Minimum="-180"
                                        Maximum="180"
                                        TickFrequency="1"
                                        Style="{StaticResource App.SliderStyle}"
                                        Value="{Binding CameraAzimuthDegrees, Mode=TwoWay}"
                                        automation:AutomationProperties.Name="相机方位角" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource IconParameterPanelStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                                               Text="{Binding CameraElevationDegrees, StringFormat={}{0:0.#}°}" />
                                    <TextBlock Style="{StaticResource IconParameterLabelStyle}"
                                               Margin="0"
                                               Text="相机仰角" />
                                </DockPanel>
                                <Slider x:Name="IconCameraElevationSlider"
                                        Minimum="-85"
                                        Maximum="85"
                                        TickFrequency="1"
                                        Style="{StaticResource App.SliderStyle}"
                                        Value="{Binding CameraElevationDegrees, Mode=TwoWay}"
                                        automation:AutomationProperties.Name="相机仰角" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource IconParameterPanelStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                                               Text="{Binding CameraRollDegrees, StringFormat={}{0:0.#}°}" />
                                    <TextBlock Style="{StaticResource IconParameterLabelStyle}"
                                               Margin="0"
                                               Text="镜头滚转" />
                                </DockPanel>
                                <Slider x:Name="IconCameraRollSlider"
                                        Minimum="-180"
                                        Maximum="180"
                                        TickFrequency="1"
                                        Style="{StaticResource App.SliderStyle}"
                                        Value="{Binding CameraRollDegrees, Mode=TwoWay}"
                                        automation:AutomationProperties.Name="镜头滚转角" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource IconParameterPanelStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                                               Text="{Binding FocalLengthMillimeters, StringFormat={}{0:0.#} mm}" />
                                    <TextBlock Style="{StaticResource IconParameterLabelStyle}"
                                               Margin="0"
                                               Text="镜头焦距" />
                                </DockPanel>
                                <Slider x:Name="IconFocalLengthSlider"
                                        Minimum="12"
                                        Maximum="200"
                                        TickFrequency="1"
                                        Style="{StaticResource App.SliderStyle}"
                                        Value="{Binding FocalLengthMillimeters, Mode=TwoWay}"
                                        automation:AutomationProperties.Name="镜头焦距" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0"
                                Style="{StaticResource IconParameterPanelStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                                               Text="{Binding CameraDistance, StringFormat={}{0:0.0}}" />
                                    <TextBlock Style="{StaticResource IconParameterLabelStyle}"
                                               Margin="0"
                                               Text="相机物距" />
                                </DockPanel>
                                <Slider x:Name="IconCameraDistanceSlider"
                                        Minimum="1.5"
                                        Maximum="20"
                                        TickFrequency="0.1"
                                        Style="{StaticResource App.SliderStyle}"
                                        Value="{Binding CameraDistance, Mode=TwoWay}"
                                        automation:AutomationProperties.Name="相机物距" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource App.SurfaceBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="10,0"
                            Background="{DynamicResource App.SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="空间关系示意" />
                            <TextBlock Style="{StaticResource IconPreviewHeaderStyle}"
                                       Text="相机布置 / 3D 空间" />
                        </DockPanel>
                    </Border>
                    <controls:IconPerspectiveSurface x:Name="IconSpatialSetupSurface"
                                                     Grid.Row="1"
                                                     Projection="{Binding Projection}"
                                                     ViewKind="SpatialSetup"
                                                     Background="{DynamicResource App.CanvasBackgroundBrush}"
                                                     GridBrush="{DynamicResource App.TilemapMinorGridBrush}"
                                                     SubjectBrush="{DynamicResource App.AccentBrush}"
                                                     SubjectEdgeBrush="{DynamicResource App.TextPrimaryBrush}"
                                                     CameraBrush="{DynamicResource App.WarningBrush}"
                                                     FrustumBrush="{DynamicResource App.TilemapGuideBrush}"
                                                     TextBrush="{DynamicResource App.TextSecondaryBrush}"
                                                     WarningBrush="{DynamicResource App.DangerBrush}"
                                                     automation:AutomationProperties.Name="Icon 相机三维空间示意" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Background="{DynamicResource App.SurfaceBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="10,0"
                            Background="{DynamicResource App.SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="{Binding FieldOfViewText}" />
                            <TextBlock Style="{StaticResource IconPreviewHeaderStyle}"
                                       Text="镜头画面 / 透视结果" />
                        </DockPanel>
                    </Border>
                    <controls:IconPerspectiveSurface x:Name="IconCameraFrameSurface"
                                                     Grid.Row="1"
                                                     Projection="{Binding Projection}"
                                                     ViewKind="CameraFrame"
                                                     Background="{DynamicResource App.CanvasBackgroundBrush}"
                                                     GridBrush="{DynamicResource App.TilemapMinorGridBrush}"
                                                     SubjectBrush="{DynamicResource App.AccentBrush}"
                                                     SubjectEdgeBrush="{DynamicResource App.TextPrimaryBrush}"
                                                     CameraBrush="{DynamicResource App.WarningBrush}"
                                                     FrustumBrush="{DynamicResource App.TilemapGuideBrush}"
                                                     TextBrush="{DynamicResource App.TextSecondaryBrush}"
                                                     WarningBrush="{DynamicResource App.DangerBrush}"
                                                     automation:AutomationProperties.Name="Icon 相机最终拍摄预览" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="10,0,10,8"
                Padding="10"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               Text="生成角度描述" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource App.TextMutedBrush}"
                               FontSize="10"
                               Text="实时同步参数" />
                </StackPanel>
                <TextBox x:Name="IconGenerationDescriptionTextBox"
                         Grid.Column="1"
                         MinHeight="52"
                         MaxHeight="70"
                         Style="{StaticResource App.TextBoxStyle}"
                         IsReadOnly="True"
                         Text="{Binding GenerationDescription, Mode=OneWay}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         automation:AutomationProperties.Name="Icon 生成角度描述" />
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Padding="12,6"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                               FontSize="10"
                               Text="{Binding CameraPositionText, StringFormat=相机坐标：{0}}" />
                    <TextBlock Margin="14,0,0,0"
                               Foreground="{DynamicResource App.TextMutedBrush}"
                               FontSize="10"
                               Text="{Binding FramingText}" />
                </StackPanel>
                <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="10"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
