<UserControl x:Class="GAssetForge.App.Views.IconDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:GAssetForge.App.Controls"
             MinWidth="620"
             MinHeight="380"
             Background="{DynamicResource App.BackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="IconPreviewHeaderStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,10"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               Text="Icon 图标制作" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource App.TextSecondaryBrush}"
                               Text="左侧检查相机与方块的空间关系，右侧确认最终镜头画面；制作参数统一在属性面板中调整。"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding ImageSizeText}" />
                    <TextBlock Margin="0,3,0,0"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource App.TextMutedBrush}"
                               FontSize="10"
                               Text="{Binding AngleDescription}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource App.SurfaceBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="10,0"
                            Background="{DynamicResource App.SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="空间关系示意" />
                            <TextBlock Style="{StaticResource IconPreviewHeaderStyle}"
                                       Text="相机布置 / 3D 空间" />
                        </DockPanel>
                    </Border>
                    <controls:IconPerspectiveSurface x:Name="IconSpatialSetupSurface"
                                                     Grid.Row="1"
                                                     Projection="{Binding Projection}"
                                                     ViewKind="SpatialSetup"
                                                     Background="{DynamicResource App.CanvasBackgroundBrush}"
                                                     GridBrush="{DynamicResource App.TilemapMinorGridBrush}"
                                                     SubjectBrush="{DynamicResource App.AccentBrush}"
                                                     SubjectEdgeBrush="{DynamicResource App.TextPrimaryBrush}"
                                                     CameraBrush="{DynamicResource App.WarningBrush}"
                                                     FrustumBrush="{DynamicResource App.TilemapGuideBrush}"
                                                     TextBrush="{DynamicResource App.TextSecondaryBrush}"
                                                     WarningBrush="{DynamicResource App.DangerBrush}"
                                                     automation:AutomationProperties.Name="Icon 相机三维空间示意" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Background="{DynamicResource App.SurfaceBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="10,0"
                            Background="{DynamicResource App.SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="{Binding FieldOfViewText}" />
                            <TextBlock Style="{StaticResource IconPreviewHeaderStyle}"
                                       Text="镜头画面 / 透视结果" />
                        </DockPanel>
                    </Border>
                    <controls:IconPerspectiveSurface x:Name="IconCameraFrameSurface"
                                                     Grid.Row="1"
                                                     Projection="{Binding Projection}"
                                                     ViewKind="CameraFrame"
                                                     Background="{DynamicResource App.CanvasBackgroundBrush}"
                                                     GridBrush="{DynamicResource App.TilemapMinorGridBrush}"
                                                     SubjectBrush="{DynamicResource App.AccentBrush}"
                                                     SubjectEdgeBrush="{DynamicResource App.TextPrimaryBrush}"
                                                     CameraBrush="{DynamicResource App.WarningBrush}"
                                                     FrustumBrush="{DynamicResource App.TilemapGuideBrush}"
                                                     TextBrush="{DynamicResource App.TextSecondaryBrush}"
                                                     WarningBrush="{DynamicResource App.DangerBrush}"
                                                     automation:AutomationProperties.Name="Icon 相机最终拍摄预览" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="12,6"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                               FontSize="10"
                               Text="{Binding CameraPositionText, StringFormat=相机坐标：{0}}" />
                    <TextBlock Margin="14,0,0,0"
                               Foreground="{DynamicResource App.TextMutedBrush}"
                               FontSize="10"
                               Text="{Binding FramingText}" />
                </StackPanel>
                <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="10"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
