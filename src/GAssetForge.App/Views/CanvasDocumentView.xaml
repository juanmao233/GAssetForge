<UserControl x:Class="GAssetForge.App.Views.CanvasDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GAssetForge.App.Converters"
             MinWidth="420"
             MinHeight="300"
             Focusable="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:StringToBrushConverter x:Key="StringToBrushConverter" />
        <conv:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadiusConverter" />

        <DataTemplate x:Key="PageTemplate">
            <Border Background="#11151B" />
        </DataTemplate>

        <DataTemplate x:Key="GenericTemplate">
            <Border Padding="14"
                    Background="{Binding Model.Style.Fill, Converter={StaticResource StringToBrushConverter}, ConverterParameter=#26313E}"
                    BorderBrush="{Binding Model.Style.Border, Converter={StaticResource StringToBrushConverter}, ConverterParameter=#46566A}"
                    BorderThickness="1"
                    CornerRadius="{Binding Radius, Converter={StaticResource DoubleToCornerRadiusConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PrimaryText}"
                               Foreground="#F3F5F7"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding TypeLabel}"
                               Foreground="#8F9BAB"
                               FontSize="12" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate">
            <Border Padding="3" Background="Transparent">
                <TextBlock Text="{Binding TextValue}"
                           Foreground="{Binding Model.Text.Color, Converter={StaticResource StringToBrushConverter}, ConverterParameter=#F3F5F7}"
                           FontFamily="{Binding Model.Text.FontFamily, FallbackValue=Microsoft YaHei UI}"
                           FontSize="{Binding Model.Text.FontSize, FallbackValue=24}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TopBarTemplate">
            <Border Background="#1D2530" BorderBrush="#384657" BorderThickness="0,0,0,1">
                <Grid Margin="48,0">
                    <TextBlock Text="‹  返回"
                               Foreground="#99A6B8"
                               FontSize="20"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PrimaryText}"
                               Foreground="#F6F8FA"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Border Padding="18,9"
                            Background="#293747"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="资源"
                                   Foreground="#C6D0DC"
                                   FontSize="15" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TitleTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PrimaryText}"
                           Foreground="#F5F7FA"
                           FontSize="48"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,10,0,0"
                           Text="{Binding SecondaryText}"
                           Foreground="#8995A5"
                           FontSize="20"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate">
            <Border Padding="32"
                    Background="#1C2530"
                    BorderBrush="#3A495B"
                    BorderThickness="1"
                    CornerRadius="{Binding Radius, Converter={StaticResource DoubleToCornerRadiusConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding PrimaryText}"
                               Foreground="#F2F5F8"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <Border Grid.Row="1" Margin="0,22,0,0" Padding="22"
                            Background="#141B24" CornerRadius="12">
                        <TextBlock Text="{Binding TertiaryText}"
                                   Foreground="#AEB8C5"
                                   FontSize="18"
                                   LineHeight="34"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ButtonTemplate">
            <Border x:Name="ButtonSurface"
                    Background="#2F78D4"
                    BorderBrush="#6AAAF4"
                    BorderThickness="1"
                    CornerRadius="{Binding Radius, Converter={StaticResource DoubleToCornerRadiusConverter}}">
                <TextBlock Text="{Binding PrimaryText}"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Variant}" Value="secondary">
                    <Setter TargetName="ButtonSurface" Property="Background" Value="#263140" />
                    <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#53657A" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="StatusTemplate">
            <Border Padding="28,20"
                    Background="#202A37"
                    BorderBrush="#4A5C72"
                    BorderThickness="1"
                    CornerRadius="{Binding Radius, Converter={StaticResource DoubleToCornerRadiusConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PrimaryText}"
                                   Foreground="#F4F7FA"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding SecondaryText}"
                                   Foreground="#94A2B3"
                                   FontSize="16" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="64" Height="64"
                            Background="#284F3F" CornerRadius="32">
                        <TextBlock Text="✓" Foreground="#71DBA9" FontSize="27"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BottomNavTemplate">
            <Border Background="#19212B" BorderBrush="#334152" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding TertiaryText}"
                           Foreground="#B8C3CF"
                           FontSize="20"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InputTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding PrimaryText}"
                           Foreground="#BFC9D5"
                           FontSize="14" />
                <Border Grid.Row="1" Margin="0,7,0,0" Padding="18,0"
                        Background="#141B24" BorderBrush="#46566B" BorderThickness="1"
                        CornerRadius="{Binding Radius, Converter={StaticResource DoubleToCornerRadiusConverter}}">
                    <TextBlock Text="{Binding SecondaryText}"
                               Foreground="#677587"
                               FontSize="17"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PanelTemplate">
            <Border Padding="28"
                    Background="#202936"
                    BorderBrush="#45566B"
                    BorderThickness="1"
                    CornerRadius="{Binding Radius, Converter={StaticResource DoubleToCornerRadiusConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding PrimaryText}"
                               Foreground="#F1F4F8"
                               FontSize="26"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding SecondaryText}"
                               Foreground="#94A1B1"
                               FontSize="16"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SliderTemplate">
            <Grid Margin="18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{Binding PrimaryText}" Foreground="#E8EDF3" FontSize="16" />
                    <TextBlock Text="{Binding SliderValue, StringFormat={}{0:0}}"
                               Foreground="#8DBFFF" FontSize="16" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Grid.Row="1" Margin="0,10,0,0"
                             Maximum="100" Value="{Binding SliderValue}"
                             Height="10" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ToggleTemplate">
            <Border Padding="18,10" Background="#202A36"
                    BorderBrush="#405166" BorderThickness="1"
                    CornerRadius="{Binding Radius, Converter={StaticResource DoubleToCornerRadiusConverter}}">
                <CheckBox IsChecked="{Binding ToggleChecked, Mode=OneWay}"
                          IsHitTestVisible="False"
                          VerticalAlignment="Center">
                    <TextBlock Margin="8,0,0,0"
                               Text="{Binding PrimaryText}"
                               Foreground="#E8EDF3"
                               FontSize="16" />
                </CheckBox>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.CanvasBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="CanvasScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      PreviewMouseWheel="CanvasScrollViewer_OnPreviewMouseWheel">
            <Grid Margin="72">
                <Border Width="{Binding CanvasWidth}"
                        Height="{Binding CanvasHeight}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{Binding CanvasBackground, Converter={StaticResource StringToBrushConverter}, ConverterParameter=#11151B}"
                        BorderBrush="#526174"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Border.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </Border.LayoutTransform>
                    <Grid x:Name="CanvasSurface"
                          Width="{Binding CanvasWidth}"
                          Height="{Binding CanvasHeight}"
                          Background="Transparent"
                          ClipToBounds="True"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="CanvasSurface_OnPreviewMouseLeftButtonDown"
                          PreviewDragOver="CanvasSurface_OnPreviewDragOver"
                          Drop="CanvasSurface_OnDrop">
                        <ItemsControl ItemsSource="{Binding CanvasLayers}"
                                      Width="{Binding CanvasWidth}"
                                      Height="{Binding CanvasHeight}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    <Setter Property="Width" Value="{Binding Width}" />
                                    <Setter Property="Height" Value="{Binding Height}" />
                                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                    <Setter Property="Opacity" Value="{Binding EffectiveOpacity}" />
                                    <Setter Property="Visibility"
                                            Value="{Binding EffectiveVisibility, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="{Binding Model.Transform.Rotation}" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="LayerHitTarget"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="2"
                                            CornerRadius="{Binding Radius, Converter={StaticResource DoubleToCornerRadiusConverter}}"
                                            Cursor="SizeAll"
                                            PreviewMouseLeftButtonDown="Layer_OnPreviewMouseLeftButtonDown"
                                            PreviewMouseMove="Layer_OnPreviewMouseMove"
                                            PreviewMouseLeftButtonUp="Layer_OnPreviewMouseLeftButtonUp"
                                            LostMouseCapture="Layer_OnLostMouseCapture">
                                        <ContentControl Content="{Binding}" Margin="-1">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource GenericTemplate}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsText}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource TextTemplate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ComponentType}" Value="page">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource PageTemplate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ComponentType}" Value="topbar">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource TopBarTemplate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ComponentType}" Value="title">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource TitleTemplate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ComponentType}" Value="card">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource CardTemplate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ComponentType}" Value="button">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource ButtonTemplate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ComponentType}" Value="status">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource StatusTemplate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ComponentType}" Value="bottomnav">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource BottomNavTemplate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ComponentType}" Value="input">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource InputTemplate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ComponentType}" Value="panel">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource PanelTemplate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ComponentType}" Value="slider">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource SliderTemplate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ComponentType}" Value="toggle">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource ToggleTemplate}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="LayerHitTarget" Property="BorderBrush"
                                                    Value="{DynamicResource App.SelectionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EffectiveLocked}" Value="True">
                                            <Setter TargetName="LayerHitTarget" Property="Cursor" Value="Arrow" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
