<UserControl x:Class="GAssetForge.App.Views.BlueprintToolPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="72">
    <Grid Background="{DynamicResource App.SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="8,10"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                           FontWeight="SemiBold"
                           Text="蓝图工具" />
                <TextBlock Margin="0,3,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="9"
                           Text="随活动主视图切换" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="7,10">
                <ToggleButton x:Name="BlueprintPointerToolButton"
                              Height="60"
                              Padding="4"
                              HorizontalContentAlignment="Center"
                              Command="{Binding SelectToolCommand}"
                              CommandParameter="pointer"
                              IsChecked="{Binding IsPointerTool, Mode=OneWay}"
                              Style="{DynamicResource App.ToggleButtonStyle}"
                              ToolTip="默认鼠标：左键选择；右键或中键拖动画布；双击右键返回 (0,0)；滚轮缩放">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Text="&#xE7C9;" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="9"
                                   Text="默认鼠标" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="BlueprintAddToolButton"
                              Height="60"
                              Margin="0,6,0,0"
                              Padding="4"
                              HorizontalContentAlignment="Center"
                              Command="{Binding SelectToolCommand}"
                              CommandParameter="add"
                              IsChecked="{Binding IsAddTool, Mode=OneWay}"
                              Style="{DynamicResource App.ToggleButtonStyle}"
                              ToolTip="左键使用当前蓝图类型；右键展开同组类型菜单">
                    <ToggleButton.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     ItemsSource="{Binding AddNodeTypes}"
                                     Placement="Right">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="{x:Type MenuItem}">
                                    <Setter Property="Header" Value="{Binding Label}" />
                                    <Setter Property="ToolTip" Value="{Binding Description}" />
                                    <Setter Property="IsCheckable" Value="False" />
                                    <EventSetter Event="Click" Handler="BlueprintAddTypeMenuItem_OnClick" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </ToggleButton.ContextMenu>
                    <Grid>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource App.TextPrimaryBrush}"
                                       FontSize="21"
                                       Text="＋" />
                            <TextBlock Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource App.TextPrimaryBrush}"
                                       FontSize="9"
                                       Text="添加蓝图" />
                            <TextBlock Margin="0,1,0,0"
                                       MaxWidth="58"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="8"
                                       Text="{Binding SelectedAddNodeTypeLabel}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Path Width="6"
                              Height="6"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Data="M 0,6 L 6,6 L 6,0 Z"
                              Fill="{DynamicResource App.TextMutedBrush}"
                              IsHitTestVisible="False"
                              Stretch="Fill" />
                    </Grid>
                </ToggleButton>

                <ToggleButton x:Name="BlueprintConnectToolButton"
                              Height="60"
                              Margin="0,6,0,0"
                              Padding="4"
                              HorizontalContentAlignment="Center"
                              Command="{Binding SelectToolCommand}"
                              CommandParameter="connect"
                              IsChecked="{Binding IsConnectTool, Mode=OneWay}"
                              Style="{DynamicResource App.ToggleButtonStyle}"
                              ToolTip="连线：输入或输出端点均可起线；选择相反方向端点完成；右键取消">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="20"
                                   Text="⌁" />
                        <TextBlock Margin="0,3,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="9"
                                   Text="连线" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="BlueprintMoveNodeToolButton"
                              Height="60"
                              Margin="0,6,0,0"
                              Padding="4"
                              HorizontalContentAlignment="Center"
                              Command="{Binding SelectToolCommand}"
                              CommandParameter="move"
                              IsChecked="{Binding IsMoveNodeTool, Mode=OneWay}"
                              Style="{DynamicResource App.ToggleButtonStyle}"
                              ToolTip="对象移动：在蓝图节点卡片上按住左键拖拽">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="18"
                                   Text="✥" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"
                                   FontSize="9"
                                   Text="对象移动" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="8,0,8,10"
                Padding="7"
                Background="{DynamicResource App.SurfaceRaisedBrush}"
                CornerRadius="5">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="9"
                           Text="当前工具" />
                <TextBlock Margin="0,3,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="9"
                           Text="{Binding ActiveToolLabel}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="9"
                           Text="{Binding ZoomText}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
