<UserControl x:Class="GAssetForge.App.Views.BackgroundRemovalPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GAssetForge.App.Converters"
             MinWidth="260">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:StringToBrushConverter x:Key="StringToBrushConverter" />
        <Style x:Key="BackgroundRemovalPropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BackgroundRemovalCompactButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource App.ButtonStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="10" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource App.SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="12,0"
                Background="{DynamicResource App.SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <TextBlock VerticalAlignment="Center"
                           Style="{DynamicResource App.PanelHeaderStyle}"
                           Text="背景剔除属性" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="11"
                           Text="色键与假透明恢复" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">
                <Border Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource App.SectionTitleStyle}"
                                   Text="背景识别模式" />
                        <CheckBox x:Name="BackgroundRemovalPropertiesFakeTransparencyCheckBox"
                                  Margin="0,11,0,0"
                                  IsChecked="{Binding UseFakeTransparencyGrid, Mode=TwoWay}"
                                  Content="启用假透明棋盘格剔除"
                                  Style="{DynamicResource App.CheckBoxStyle}" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="10"
                                   Text="{Binding BackgroundModeText}"
                                   TextWrapping="Wrap" />

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding IsSolidColorMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,0,5"
                                       Style="{StaticResource BackgroundRemovalPropertyLabelStyle}"
                                       Text="背景底色" />
                            <ComboBox x:Name="BackgroundRemovalPropertiesPresetComboBox"
                                      ItemsSource="{Binding PresetOptions}"
                                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{DynamicResource App.ComboBoxStyle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30"
                                        Height="30"
                                        Background="{Binding EffectiveColorHex, Converter={StaticResource StringToBrushConverter}}"
                                        BorderBrush="{DynamicResource App.BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontFamily="Consolas"
                                               FontWeight="SemiBold"
                                               Text="{Binding EffectiveColorHex}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{DynamicResource App.TextMutedBrush}"
                                               FontSize="10"
                                               Text="{Binding PresetGuidanceText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding IsCustomPreset, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BackgroundRemovalPropertiesCustomColorTextBox"
                                         FontFamily="Consolas"
                                         Text="{Binding CustomColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource App.TextBoxStyle}" />
                                <Button Grid.Column="2"
                                        Width="34"
                                        Height="30"
                                        Padding="0"
                                        Background="{Binding EffectiveColorHex, Converter={StaticResource StringToBrushConverter}}"
                                        BorderBrush="{DynamicResource App.BorderStrongBrush}"
                                        BorderThickness="1"
                                        Command="{Binding ChooseCustomColorCommand}"
                                        ToolTip="打开 HSV / RGB 取色器" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding UseFakeTransparencyGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource BackgroundRemovalPropertyLabelStyle}"
                                       Text="棋盘格两种颜色" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{Binding EffectiveCheckerColorAHex, Converter={StaticResource StringToBrushConverter}}"
                                        BorderBrush="{DynamicResource App.BorderStrongBrush}"
                                        BorderThickness="1"
                                        Command="{Binding ChooseCheckerColorACommand}"
                                        ToolTip="选择网格颜色 A" />
                                <TextBox x:Name="BackgroundRemovalPropertiesCheckerColorATextBox"
                                         Grid.Column="2"
                                         FontFamily="Consolas"
                                         Text="{Binding CheckerColorAHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource App.TextBoxStyle}" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="{Binding EffectiveCheckerColorBHex, Converter={StaticResource StringToBrushConverter}}"
                                        BorderBrush="{DynamicResource App.BorderStrongBrush}"
                                        BorderThickness="1"
                                        Command="{Binding ChooseCheckerColorBCommand}"
                                        ToolTip="选择网格颜色 B" />
                                <TextBox x:Name="BackgroundRemovalPropertiesCheckerColorBTextBox"
                                         Grid.Column="2"
                                         FontFamily="Consolas"
                                         Text="{Binding CheckerColorBHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource App.TextBoxStyle}" />
                            </Grid>
                            <Button x:Name="BackgroundRemovalPropertiesSwapCheckerColorsButton"
                                    Margin="0,7,0,0"
                                    Command="{Binding SwapCheckerColorsCommand}"
                                    Content="交换 A / B 颜色相位"
                                    Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                            <CheckBox x:Name="BackgroundRemovalPropertiesCheckerAlignmentCheckBox"
                                      Margin="0,10,0,0"
                                      IsChecked="{Binding EnableCheckerGridAlignment, Mode=TwoWay}"
                                      Content="启用网格对齐"
                                      Style="{DynamicResource App.CheckBoxStyle}" />
                            <CheckBox x:Name="BackgroundRemovalPropertiesSmartCheckerDetectionCheckBox"
                                      Margin="0,8,0,0"
                                      IsChecked="{Binding EnableSmartCheckerDetection, Mode=TwoWay}"
                                      Content="处理时逐图智能识别棋盘格"
                                      Style="{DynamicResource App.CheckBoxStyle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,4"
                                               Text="最小格宽（px）"
                                               Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                                    <TextBox x:Name="BackgroundRemovalPropertiesCheckerDetectionMinimumCellSizeTextBox"
                                             Text="{Binding CheckerDetectionMinimumCellSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                             Style="{DynamicResource App.TextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,4"
                                               Text="最大格宽（px）"
                                               Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                                    <TextBox x:Name="BackgroundRemovalPropertiesCheckerDetectionMaximumCellSizeTextBox"
                                             Text="{Binding CheckerDetectionMaximumCellSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                             Style="{DynamicResource App.TextBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,4"
                                               Text="四角扫描范围（短边 %）"
                                               Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                                    <TextBox x:Name="BackgroundRemovalPropertiesCheckerDetectionSearchRangeTextBox"
                                             Text="{Binding CheckerDetectionSearchRangePercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}"
                                             Style="{DynamicResource App.TextBoxStyle}" />
                                </StackPanel>
                                <Button x:Name="BackgroundRemovalPropertiesDetectCheckerGridButton"
                                        Grid.Column="2"
                                        MinWidth="84"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding DetectCheckerGridCommand}"
                                        Content="识别当前图片"
                                        Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                            </Grid>
                            <ProgressBar Height="4"
                                         Margin="0,7,0,0"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsCheckerGridDetecting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource App.AccentBrush}"
                                       FontSize="10"
                                       Text="{Binding CheckerDetectionStatusText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="智能模式会从四个角分别识别两种主色、格子周期与相位；每张批处理图片都会独立检测，不复用上一张图片的格宽。"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,8,0,0"
                                  IsEnabled="{Binding EnableCheckerGridAlignment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,4" Text="格子尺寸（px，可小数）"
                                               Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                                    <TextBox x:Name="BackgroundRemovalPropertiesCheckerCellSizeTextBox"
                                             Text="{Binding CheckerCellSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                             Style="{DynamicResource App.TextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,4" Text="边界容差（px，可小数）"
                                               Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                                    <TextBox x:Name="BackgroundRemovalPropertiesCheckerBoundaryToleranceTextBox"
                                             Text="{Binding CheckerBoundaryTolerance, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                             Style="{DynamicResource App.TextBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0"
                                  IsEnabled="{Binding EnableCheckerGridAlignment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,4" Text="X 偏移（px，可小数）"
                                               Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                                    <TextBox x:Name="BackgroundRemovalPropertiesCheckerOffsetXTextBox"
                                             Text="{Binding CheckerOffsetX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                             Style="{DynamicResource App.TextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,4" Text="Y 偏移（px，可小数）"
                                               Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                                    <TextBox x:Name="BackgroundRemovalPropertiesCheckerOffsetYTextBox"
                                             Text="{Binding CheckerOffsetY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}"
                                             Style="{DynamicResource App.TextBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource App.AccentBrush}"
                                       FontSize="10"
                                       Text="也可在原图空白处拖出标准正方形；拖框体定位、拖四角缩放，结束后按源图像素边长和左上角偏移更新网格。"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource App.TextMutedBrush}"
                                       FontSize="10"
                                       Text="{Binding CheckerAlignmentSummary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource App.SectionTitleStyle}"
                                   Text="透明与边缘" />
                        <TextBlock Margin="0,11,0,4" Text="透明阈值"
                                   Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                       Text="{Binding TransparentThreshold, StringFormat={}{0:0}}" />
                            <Slider x:Name="BackgroundRemovalPropertiesTransparentThresholdSlider"
                                    Minimum="0" Maximum="180" TickFrequency="1"
                                    Value="{Binding TransparentThreshold, Mode=TwoWay}"
                                    Style="{DynamicResource App.SliderStyle}" />
                        </DockPanel>
                        <TextBlock Margin="0,10,0,4" Text="不透明阈值"
                                   Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                       Text="{Binding OpaqueThreshold, StringFormat={}{0:0}}" />
                            <Slider x:Name="BackgroundRemovalPropertiesOpaqueThresholdSlider"
                                    Minimum="1" Maximum="300" TickFrequency="1"
                                    Value="{Binding OpaqueThreshold, Mode=TwoWay}"
                                    Style="{DynamicResource App.SliderStyle}" />
                        </DockPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="边缘收缩"
                                           Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                                <ComboBox ItemsSource="{Binding EdgeContractOptions}"
                                          SelectedItem="{Binding EdgeContract, Mode=TwoWay}"
                                          Style="{DynamicResource App.ComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="边缘羽化"
                                           Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                                <ComboBox ItemsSource="{Binding EdgeFeatherOptions}"
                                          SelectedItem="{Binding EdgeFeather, Mode=TwoWay}"
                                          Style="{DynamicResource App.ComboBoxStyle}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="BackgroundRemovalPropertiesRemoveEnclosedCheckBox"
                                  Margin="0,12,0,0"
                                  IsChecked="{Binding RemoveEnclosedBackground, Mode=TwoWay}"
                                  Content="剔除镂空区域内部背景"
                                  Style="{DynamicResource App.CheckBoxStyle}" />
                        <TextBlock Margin="22,4,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="10"
                                   Text="关闭后仅处理与画布外边缘连通的底色。"
                                   TextWrapping="Wrap" />
                        <CheckBox Margin="0,8,0,0"
                                  IsChecked="{Binding Despill, Mode=TwoWay}"
                                  Content="清理半透明边缘的底色污染"
                                  Style="{DynamicResource App.CheckBoxStyle}" />
                        <TextBlock Margin="0,9,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="10"
                                   Text="{Binding ConfigurationValidationText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource App.SectionTitleStyle}" Text="单图操作" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="BackgroundRemovalPropertiesChooseInputButton"
                                    Margin="0,0,6,6"
                                    Command="{Binding ChooseInputCommand}"
                                    Content="选择图片…"
                                    Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                            <Button x:Name="BackgroundRemovalPropertiesChooseOutputButton"
                                    Margin="0,0,0,6"
                                    Command="{Binding ChooseOutputCommand}"
                                    Content="设置输出…"
                                    Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                        </WrapPanel>
                        <WrapPanel>
                            <Button x:Name="BackgroundRemovalPropertiesRefreshPreviewButton"
                                    Margin="0,0,6,6"
                                    Command="{Binding RefreshPreviewCommand}"
                                    Content="刷新预览"
                                    Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                            <Button x:Name="BackgroundRemovalPropertiesSaveResultButton"
                                    Margin="0,0,0,6"
                                    Command="{Binding SaveResultCommand}"
                                    Content="保存结果"
                                    Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                        </WrapPanel>
                        <TextBlock Margin="0,5,0,2" Text="输入"
                                   Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                        <TextBlock Text="{Binding InputFileName}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding InputPath}" />
                        <TextBlock Margin="0,8,0,2" Text="输出"
                                   Style="{StaticResource BackgroundRemovalPropertyLabelStyle}" />
                        <TextBlock Text="{Binding OutputFileName}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding OutputPath}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="10"
                                   Text="{Binding PreviewStatusText}"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,9,0,0"
                                Command="{Binding OpenOutputDirectoryCommand}"
                                Content="打开输出目录"
                                Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" Style="{DynamicResource App.CardStyle}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource App.AccentBrush}"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       Text="{Binding BatchTotalCount, StringFormat={}{0}/256}" />
                            <TextBlock Style="{DynamicResource App.SectionTitleStyle}" Text="批量处理" />
                        </DockPanel>
                        <CheckBox x:Name="BackgroundRemovalPropertiesBatchModeCheckBox"
                                  Margin="0,10,0,0"
                                  IsChecked="{Binding IsBatchMode, Mode=TwoWay}"
                                  Content="批量处理模式"
                                  Style="{DynamicResource App.CheckBoxStyle}" />
                        <WrapPanel Margin="0,9,0,0">
                            <Button x:Name="BackgroundRemovalPropertiesChooseBatchInputsButton"
                                    Margin="0,0,6,6"
                                    Command="{Binding ChooseBatchInputsCommand}"
                                    Content="添加图片…"
                                    Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                            <Button x:Name="BackgroundRemovalPropertiesChooseBatchOutputButton"
                                    Margin="0,0,0,6"
                                    Command="{Binding ChooseBatchOutputDirectoryCommand}"
                                    Content="输出目录…"
                                    Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                        </WrapPanel>
                        <TextBlock Margin="0,2,0,2"
                                   Style="{StaticResource BackgroundRemovalPropertyLabelStyle}"
                                   Text="批量输出目录" />
                        <TextBlock FontFamily="Consolas"
                                   FontSize="10"
                                   Text="{Binding BatchOutputDirectory, TargetNullValue=尚未选择}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding BatchOutputDirectory}" />
                        <ListBox x:Name="BackgroundRemovalPropertiesBatchQueue"
                                 MinHeight="84"
                                 MaxHeight="180"
                                 Margin="0,3,0,0"
                                 ItemsSource="{Binding BatchItems}"
                                 SelectedItem="{Binding SelectedBatchItem, Mode=TwoWay}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                                   FontSize="9"
                                                   Text="{Binding StatusText}" />
                                        <TextBlock Foreground="{DynamicResource App.TextMutedBrush}"
                                                   FontSize="9"
                                                   Text="{Binding CheckerDetectionText}"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding CheckerDetectionText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="BackgroundRemovalPropertiesRemoveBatchItemButton"
                                    Margin="0,0,6,6"
                                    Command="{Binding RemoveSelectedBatchItemCommand}"
                                    Content="移除所选"
                                    Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                            <Button x:Name="BackgroundRemovalPropertiesClearBatchButton"
                                    Margin="0,0,0,6"
                                    Command="{Binding ClearBatchItemsCommand}"
                                    Content="清空队列"
                                    Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                        </WrapPanel>
                        <Button x:Name="BackgroundRemovalPropertiesProcessBatchButton"
                                Command="{Binding ProcessBatchCommand}"
                                 Content="执行批量背景剔除"
                                 Style="{StaticResource BackgroundRemovalCompactButtonStyle}" />
                        <ProgressBar Height="6"
                                     Margin="0,9,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding BatchProgressPercent, Mode=OneWay}" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontSize="10"
                                   Text="{Binding BatchProgressText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="10"
                                   Text="{Binding BatchCurrentFileName, StringFormat=当前：{0}}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="10"
                                   Text="{Binding BatchStatusText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,10,2,12"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="10"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
