<UserControl x:Class="GAssetForge.App.Views.TilemapWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:GAssetForge.App.Controls"
             MinWidth="420"
             MinHeight="280">
    <Grid Background="{DynamicResource App.TilemapGridBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Grid ClipToBounds="True">
            <controls:TilemapGridSurface x:Name="TilemapGridSurface"
                                         automation:AutomationProperties.Name="Tilemap 网格工作区"
                                         CellSize="{Binding GridUnitSize}"
                                         MajorLineInterval="{Binding MajorLineInterval}"
                                         DiamondAngle="{Binding DiamondAngle}"
                                         GridRotation="{Binding RotationAngle}"
                                         Background="{DynamicResource App.TilemapGridBackgroundBrush}"
                                         MinorGridBrush="{DynamicResource App.TilemapMinorGridBrush}"
                                         MajorGridBrush="{DynamicResource App.TilemapMajorGridBrush}"
                                         XAxisBrush="{DynamicResource App.TilemapXAxisBrush}"
                                         YAxisBrush="{DynamicResource App.TilemapYAxisBrush}"
                                         HoverCellBrush="{DynamicResource App.TilemapHoverCellBrush}"
                                         HoverCellBorderBrush="{DynamicResource App.TilemapGuideBrush}" />

            <Border Margin="12"
                    Padding="10,7"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{DynamicResource App.TilemapOverlayBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock Text="GRID"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding ArtSizeText}"
                               Foreground="{DynamicResource App.TilemapGuideBrush}"
                               FontWeight="SemiBold" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock Text="{Binding TileShapeText}"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontSize="11" />
                        <TextBlock Text=" · 边夹角 "
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontSize="11" />
                        <TextBlock Text="{Binding DiamondAngle, StringFormat={}{0:0.#}°}"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontSize="11" />
                        <TextBlock Margin="10,0,0,0"
                                   Text="A 边方向 "
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="11" />
                        <TextBlock Text="{Binding RotationAngle, StringFormat={}{0:0.#}°}"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="12"
                    Padding="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource App.TilemapOverlayBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TilemapZoomOutButton"
                            Width="30" Height="28" Content="−"
                            Style="{DynamicResource App.IconButtonStyle}"
                            ToolTip="缩小网格"
                            Click="ZoomOut_OnClick" />
                    <Button x:Name="TilemapResetViewButton"
                            MinWidth="58" Height="28" Margin="4,0"
                            Content="{Binding ElementName=TilemapGridSurface, Path=ZoomText}"
                            Style="{DynamicResource App.ToolbarButtonStyle}"
                            ToolTip="重置网格视图"
                            Click="ResetView_OnClick" />
                    <Button x:Name="TilemapZoomInButton"
                            Width="30" Height="28" Content="＋"
                            Style="{DynamicResource App.IconButtonStyle}"
                            ToolTip="放大网格"
                            Click="ZoomIn_OnClick" />
                </StackPanel>
            </Border>

            <Border Margin="12"
                    Padding="10,7"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{DynamicResource App.TilemapOverlayBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource App.TilemapXAxisBrush}" />
                    <TextBlock Margin="5,0,12,0" Text="X"
                               Foreground="{DynamicResource App.TextSecondaryBrush}" />
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource App.TilemapYAxisBrush}" />
                    <TextBlock Margin="5,0,12,0" Text="Y"
                               Foreground="{DynamicResource App.TextSecondaryBrush}" />
                    <TextBlock Text="格 " Foreground="{DynamicResource App.TextMutedBrush}" />
                    <TextBlock Text="{Binding ElementName=TilemapGridSurface, Path=HoveredCellText}"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Padding="14,9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource App.TilemapOverlayBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    IsHitTestVisible="False"
                    Opacity="0.8">
                <TextBlock Text="{Binding EmptyGridHint}"
                           Foreground="{DynamicResource App.TextMutedBrush}" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Padding="10,0"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontSize="11"
                           Text="中键拖动 · 滚轮缩放" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           FontSize="11"
                           Text="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
