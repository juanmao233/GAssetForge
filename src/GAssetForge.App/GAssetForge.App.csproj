<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GAssetForge.App</RootNamespace>
    <AssemblyName>GAssetForge</AssemblyName>
    <Title>GAssetForge</Title>
    <Product>GAssetForge 游戏美术资产生成工作台</Product>
    <Description>面向游戏美术资产制作的透视约束、工作流编排与 AI 生成桌面工具。</Description>
    <Company>GAssetForge</Company>
    <Authors>GAssetForge</Authors>
    <Copyright>Copyright © GAssetForge 2026</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <ApplicationIcon>Assets\Branding\GAssetForge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GAssetForge.Core\GAssetForge.Core.csproj" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Branding\GAssetForge.ico" />
    <Resource Include="Assets\Branding\GAssetForge.png" />
  </ItemGroup>
</Project>
